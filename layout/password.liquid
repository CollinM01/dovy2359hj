<!DOCTYPE html>
<html lang="{{ request.locale.iso_code }}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  {{ 'theme.css' | asset_url | stylesheet_tag }}
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500;0,600;0,700;1,300;1,400;1,500&family=Jost:wght@300;400;500;600&display=swap" rel="stylesheet">
  <title>{{ shop.name }} — {{ 'general.password_page.opening_soon' | t }}</title>
  {{ content_for_header }}
  <style>
    :root {
      --color-paper:  {{ settings.colors_paper }};
      --color-bark:   {{ settings.colors_bark }};
      --color-sage:   {{ settings.colors_sage }};
      --color-fog:    {{ settings.colors_fog }};
      --color-ink:    {{ settings.colors_ink }};
      --color-cream:  {{ settings.colors_cream }};
      --color-moss:   {{ settings.colors_moss }};
    }
  </style>
</head>
<body class="template-password">
  {% section 'main-password' %}
</body>
</html>
