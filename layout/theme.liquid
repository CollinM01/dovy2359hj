<!DOCTYPE html>
<html lang="{{ request.locale.iso_code }}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="theme-color" content="{{ settings.colors_paper }}">

  {%- if settings.favicon != blank -%}
    <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 32, height: 32 }}">
  {%- endif -%}

  {{ 'theme.css' | asset_url | stylesheet_tag }}

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500;0,600;0,700;1,300;1,400;1,500&family=Jost:wght@300;400;500;600&display=swap" rel="stylesheet">

  <title>
    {{ page_title }}
    {%- if current_tags %} &ndash; {{ current_tags | join: ', ' }}{%- endif -%}
    {%- if current_page != 1 %} &ndash; {{ 'general.pagination.page' | t: number: current_page }}{%- endif -%}
    {%- unless page_title contains shop.name %} &ndash; {{ shop.name }}{%- endunless -%}
  </title>

  {%- if page_description -%}
    <meta name="description" content="{{ page_description | escape }}">
  {%- endif -%}

  <!-- Open Graph -->
  <meta property="og:site_name" content="{{ shop.name }}">
  <meta property="og:url" content="{{ canonical_url }}">
  <meta property="og:title" content="{{ page_title | escape }}">
  {%- if page_description -%}
    <meta property="og:description" content="{{ page_description | escape }}">
  {%- endif -%}
  {%- if template.name == 'product' -%}
    <meta property="og:type" content="product">
    {%- if product.featured_image -%}
      <meta property="og:image" content="https:{{ product.featured_image | image_url: width: 1200 }}">
      <meta property="og:image:width" content="1200">
    {%- endif -%}
  {%- elsif template.name == 'article' -%}
    <meta property="og:type" content="article">
    {%- if article.image -%}
      <meta property="og:image" content="https:{{ article.image | image_url: width: 1200 }}">
    {%- endif -%}
  {%- else -%}
    <meta property="og:type" content="website">
  {%- endif -%}

  {{ content_for_header }}

  <style>
    :root {
      --color-paper:  {{ settings.colors_paper }};
      --color-bark:   {{ settings.colors_bark }};
      --color-sage:   {{ settings.colors_sage }};
      --color-fog:    {{ settings.colors_fog }};
      --color-ink:    {{ settings.colors_ink }};
      --color-cream:  {{ settings.colors_cream }};
      --color-moss:   {{ settings.colors_moss }};
    }
  </style>
</head>

<body class="template-{{ template.name }}{% if template.suffix %} template-{{ template.suffix }}{% endif %}">

  <a class="visually-hidden" href="#MainContent">{{ 'accessibility.skip_to_content' | t }}</a>

  {% section 'announcement-bar' %}
  {% section 'header' %}

  <main id="MainContent" role="main" tabindex="-1">
    {{ content_for_layout }}
  </main>

  {% section 'footer' %}
  {% section 'cart-drawer' %}

  <quick-view-modal></quick-view-modal>

  <div id="QuickViewModal" class="quick-view-modal" aria-hidden="true" role="dialog" aria-modal="true">
    <div class="quick-view-modal__overlay" id="QuickViewClose"></div>
    <div class="quick-view-modal__panel">
      <button class="quick-view-modal__close" id="QuickViewClose2" aria-label="{{ 'accessibility.close' | t }}">
        {% render 'icon-close' %}
      </button>
      <div class="quick-view-modal__content" id="QuickViewContent">
        <div class="quick-view-modal__loading">
          {% render 'icon-loader' %}
        </div>
      </div>
    </div>
  </div>

  {{ 'global.js'               | asset_url | script_tag }}
  {{ 'toast.js'                | asset_url | script_tag }}
  {{ 'accordion.js'            | asset_url | script_tag }}
  {{ 'product-form.js'         | asset_url | script_tag }}
  {{ 'quick-view.js'           | asset_url | script_tag }}
  {{ 'marquee.js'              | asset_url | script_tag }}
  {{ 'cart-drawer.js'          | asset_url | script_tag }}
  {{ 'header.js'               | asset_url | script_tag }}
  {{ 'details-modal.js'        | asset_url | script_tag }}
  {{ 'search-form.js'          | asset_url | script_tag }}
  {{ 'predictive-search.js'    | asset_url | script_tag }}
  {{ 'product-media-gallery.js'| asset_url | script_tag }}
  {{ 'theme.js'                | asset_url | script_tag }}

</body>
</html>
