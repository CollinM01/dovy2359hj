{%- comment -%}
  Renders a product card.
  Accepts:
  - product: {Object} Product liquid object
  - show_quick_view: {Boolean} Show quick view button
{%- endcomment -%}

{%- liquid
  assign ratio = settings.product_card_ratio | default: 'portrait'
-%}

<div class="product-card" data-product-id="{{ product.id }}">
  <div class="product-card__image-wrapper">
    <a href="{{ product.url }}" class="product-card__image-link" aria-label="{{ product.title | escape }}">
      {%- if product.featured_image -%}
        <img class="product-card__image"
             src="{{ product.featured_image | image_url: width: 600 }}"
             srcset="{{ product.featured_image | image_url: width: 300 }} 300w,
                     {{ product.featured_image | image_url: width: 600 }} 600w,
                     {{ product.featured_image | image_url: width: 900 }} 900w"
             sizes="(max-width: 480px) calc(50vw - 2rem), (max-width: 900px) calc(33vw - 2rem), 280px"
             alt="{{ product.featured_image.alt | default: product.title | escape }}"
             loading="lazy"
             width="600"
             height="{{ 600 | divided_by: product.featured_image.aspect_ratio | round }}">
        {%- if product.images[1] -%}
          <img class="product-card__image product-card__image--hover"
               src="{{ product.images[1] | image_url: width: 600 }}"
               srcset="{{ product.images[1] | image_url: width: 300 }} 300w,
                       {{ product.images[1] | image_url: width: 600 }} 600w"
               sizes="(max-width: 480px) calc(50vw - 2rem), 280px"
               alt="{{ product.images[1].alt | default: product.title | escape }}"
               loading="lazy"
               aria-hidden="true">
        {%- endif -%}
      {%- else -%}
        <div class="product-card__image product-card__placeholder" aria-hidden="true">
          {{ 'product-1' | placeholder_svg_tag }}
        </div>
      {%- endif -%}
    </a>

    {%- if product.compare_at_price > product.price -%}
      <span class="badge badge--sale">{{ 'products.product.sale' | t }}</span>
    {%- endif -%}

    {%- if show_quick_view != false -%}
      <button class="product-card__quick-view btn btn--outline btn--small"
              data-quick-view-btn
              data-product-url="{{ product.url }}"
              aria-label="{{ 'products.product.quick_view' | t | escape }}">
        {{ 'products.product.quick_view' | t }}
      </button>
    {%- endif -%}
  </div>

  <div class="product-card__info">
    {%- if product.vendor != blank -%}
      <p class="product-card__vendor">{{ product.vendor }}</p>
    {%- endif -%}
    <h3 class="product-card__title">
      <a href="{{ product.url }}">{{ product.title }}</a>
    </h3>
    <div class="product-card__price">
      {% render 'price', product: product %}
    </div>

    {%- unless product.has_only_default_variant -%}
      {%- assign color_option = product.options_with_values | where: 'name', 'Color' | first -%}
      {%- if color_option -%}
        <div class="product-card__swatches" aria-label="{{ 'products.facets.color' | t }}">
          {%- for value in color_option.values -%}
            <span class="swatch swatch--sm"
                  style="background-color: {{ value | downcase | replace: ' ', '-' }};"
                  title="{{ value | escape }}"
                  aria-label="{{ value | escape }}"></span>
          {%- endfor -%}
        </div>
      {%- endif -%}
    {%- endunless -%}
  </div>
</div>
