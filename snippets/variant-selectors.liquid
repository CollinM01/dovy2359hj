{%- comment -%}
  Renders variant selector inputs (Color swatches + Size buttons + generic selects).
  Accepts:
  - product: {Object} Product liquid object
  - section: {Object} Section object (used for unique IDs)
{%- endcomment -%}

{%- for option in product.options_with_values -%}
  <div class="variant-selector" data-option-index="{{ forloop.index0 }}" data-option-name="{{ option.name | escape }}">

    <label class="variant-selector__label">
      {{ option.name }}
      {%- if option.name == 'Color' or option.name == 'Colour' -%}
        : <span class="variant-selector__selected-value" data-selected-value>{{ option.selected_value }}</span>
      {%- endif -%}
    </label>

    {%- if option.name == 'Color' or option.name == 'Colour' -%}
      <div class="swatches" role="radiogroup" aria-label="{{ option.name | escape }}">
        {%- for value in option.values -%}
          {%- liquid
            assign option_available = false
            for variant in product.variants
              if variant.available
                case option.position
                  when 1
                    if variant.option1 == value
                      assign option_available = true
                    end
                  when 2
                    if variant.option2 == value
                      assign option_available = true
                    end
                  when 3
                    if variant.option3 == value
                      assign option_available = true
                    end
                endcase
              end
            endfor
          -%}
          <label class="swatch{% if value == option.selected_value %} swatch--selected{% endif %}{% unless option_available %} swatch--sold-out{% endunless %}"
                 title="{{ value | escape }}"
                 aria-label="{{ value | escape }}">
            <input type="radio"
                   name="options[{{ option.name | escape }}]"
                   value="{{ value | escape }}"
                   class="visually-hidden"
                   {% if value == option.selected_value %}checked{% endif %}
                   {% unless option_available %}data-sold-out="true"{% endunless %}>
            <span class="swatch__color"
                  style="background-color: {{ value | downcase | replace: ' ', '' | replace: '/', '-' }};"
                  aria-hidden="true"></span>
          </label>
        {%- endfor -%}
      </div>

    {%- elsif option.name == 'Size' or option.name == 'size' -%}
      <div class="size-buttons" role="radiogroup" aria-label="{{ option.name | escape }}">
        {%- for value in option.values -%}
          {%- liquid
            assign option_available = false
            for variant in product.variants
              if variant.available
                case option.position
                  when 1
                    if variant.option1 == value
                      assign option_available = true
                    end
                  when 2
                    if variant.option2 == value
                      assign option_available = true
                    end
                  when 3
                    if variant.option3 == value
                      assign option_available = true
                    end
                endcase
              end
            endfor
          -%}
          <label class="size-btn{% if value == option.selected_value %} size-btn--selected{% endif %}{% unless option_available %} size-btn--sold-out{% endunless %}"
                 aria-label="{{ value | escape }}">
            <input type="radio"
                   name="options[{{ option.name | escape }}]"
                   value="{{ value | escape }}"
                   class="visually-hidden"
                   {% if value == option.selected_value %}checked{% endif %}
                   {% unless option_available %}data-sold-out="true"{% endunless %}>
            {{ value }}
          </label>
        {%- endfor -%}
      </div>

    {%- else -%}
      <div class="select-wrapper">
        <select name="options[{{ option.name | escape }}]"
                id="Option-{{ section.id }}-{{ forloop.index0 }}"
                class="variant-selector__select"
                aria-label="{{ option.name | escape }}">
          {%- for value in option.values -%}
            <option value="{{ value | escape }}"
                    {% if value == option.selected_value %}selected{% endif %}>
              {{ value }}
            </option>
          {%- endfor -%}
        </select>
      </div>
    {%- endif -%}

  </div>
{%- endfor -%}
