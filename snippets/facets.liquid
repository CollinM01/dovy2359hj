{%- comment -%}
  Renders filter facets for collection pages.
  Accepts:
  - results: {Object} Collection or search results object
{%- endcomment -%}

<form id="FacetFiltersForm" class="facets">
  {%- for filter in results.filters -%}
    <details class="facets__group" id="Details-{{ filter.label | handleize }}" open>
      <summary class="facets__heading">
        {{ filter.label }}
        {% render 'icon-chevron' %}
      </summary>
      <div class="facets__body">
        {%- case filter.type -%}
          {%- when 'boolean', 'list' -%}
            <ul class="facets__list" role="list">
              {%- for value in filter.values -%}
                <li class="facets__item">
                  <label class="facets__label{% if value.count == 0 and value.active == false %} is-disabled{% endif %}">
                    <input type="checkbox"
                           name="{{ value.param_name }}"
                           value="{{ value.value }}"
                           {% if value.active %}checked{% endif %}
                           {% if value.count == 0 and value.active == false %}disabled{% endif %}
                           class="facets__checkbox"
                           onchange="this.closest('form').submit()">
                    {%- if filter.label == 'Color' or filter.label == 'Colour' -%}
                      <span class="swatch swatch--sm" style="background-color: {{ value.label | downcase | replace: ' ', '-' }};"></span>
                    {%- endif -%}
                    <span>{{ value.label }}</span>
                    <span class="facets__count">({{ value.count }})</span>
                  </label>
                </li>
              {%- endfor -%}
            </ul>

          {%- when 'price_range' -%}
            <div class="facets__price-range">
              <div style="display:flex; gap:var(--space-3); align-items:center">
                <div class="form-group" style="margin:0; flex:1">
                  <label style="font-size:0.75rem">Min</label>
                  <input type="number"
                         name="{{ filter.min_value.param_name }}"
                         value="{{ filter.min_value.value | divided_by: 100.0 }}"
                         placeholder="{{ filter.range_min | divided_by: 100.0 }}"
                         min="{{ filter.range_min | divided_by: 100.0 }}"
                         max="{{ filter.range_max | divided_by: 100.0 }}"
                         onchange="this.closest('form').submit()">
                </div>
                <span style="padding-top:1.5rem">—</span>
                <div class="form-group" style="margin:0; flex:1">
                  <label style="font-size:0.75rem">Max</label>
                  <input type="number"
                         name="{{ filter.max_value.param_name }}"
                         value="{{ filter.max_value.value | divided_by: 100.0 }}"
                         placeholder="{{ filter.range_max | divided_by: 100.0 }}"
                         min="{{ filter.range_min | divided_by: 100.0 }}"
                         max="{{ filter.range_max | divided_by: 100.0 }}"
                         onchange="this.closest('form').submit()">
                </div>
              </div>
            </div>
        {%- endcase -%}
      </div>
    </details>
  {%- endfor -%}

  {%- assign active_filters = results.filters | where: 'active_values' -%}
  {%- if active_filters.size > 0 -%}
    <div class="facets__active">
      <h3 class="facets__active-title">Active filters:</h3>
      <ul class="facets__active-list" role="list">
        {%- for filter in results.filters -%}
          {%- for value in filter.active_values -%}
            <li>
              <a href="{{ value.url_to_remove }}" class="badge badge--removable">
                {{ value.label }} {% render 'icon-close' %}
              </a>
            </li>
          {%- endfor -%}
        {%- endfor -%}
      </ul>
      <a href="{{ results.url }}?sort_by={{ results.sort_by }}" class="btn btn--outline btn--small">
        {{ 'products.facets.clear_all' | t }}
      </a>
    </div>
  {%- endif -%}
</form>
