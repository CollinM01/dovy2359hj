{%- comment -%}
  Renders an accordion item.
  Accepts:
  - title: {String} Accordion header text
  - content: {String} HTML content
  - open: {Boolean} Whether open by default
  - id: {String} Optional unique ID
{%- endcomment -%}

<accordion-component
  class="accordion"
  {% if open %}data-open="true"{% endif %}
  {% if id != blank %}id="{{ id }}"{% endif %}>
  <button class="accordion__trigger" type="button" aria-expanded="{{ open | default: false }}">
    <span>{{ title }}</span>
    <span class="accordion__icon" aria-hidden="true">{% render 'icon-chevron' %}</span>
  </button>
  <div class="accordion__content" {% unless open %}hidden{% endunless %}>
    <div class="accordion__body">
      {{ content }}
    </div>
  </div>
</accordion-component>
