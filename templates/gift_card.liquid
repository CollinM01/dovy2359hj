<!doctype html>
<html lang="{{ request.locale.iso_code }}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <meta name="theme-color" content="{{ settings.color_background }}">
  <title>{{ 'gift_cards.issued.title' | t: value: gift_card.initial_value | money_without_trailing_zeros, shop: shop.name }}</title>
  {{ content_for_header }}
  {{ 'theme.css' | asset_url | stylesheet_tag }}
  <style>
    :root {
      --color-paper:  {{ settings.color_background }};
      --color-ink:    {{ settings.color_text }};
      --color-bark:   {{ settings.color_primary }};
      --color-sage:   {{ settings.color_secondary }};
      --color-fog:    {{ settings.color_border }};
      --color-cream:  {{ settings.color_surface }};
      --color-moss:   {{ settings.color_accent }};
    }
  </style>
</head>
<body style="background:var(--color-cream); display:flex; align-items:center; justify-content:center; min-height:100vh; padding:var(--space-6)">
  <div class="card" style="max-width:480px; width:100%; padding:var(--space-10); text-align:center">
    {%- if settings.logo != blank -%}
      <img src="{{ settings.logo | image_url: width: 160 }}" alt="{{ shop.name }}" width="160" style="margin-bottom:var(--space-6)">
    {%- else -%}
      <h2 style="margin-bottom:var(--space-6)">{{ shop.name }}</h2>
    {%- endif -%}

    <h1 style="font-size:1.25rem; margin-bottom:var(--space-2)">
      {{ 'gift_cards.issued.subtext' | t }}
    </h1>
    <p style="font-size:2.5rem; font-weight:700; color:var(--color-bark); margin-bottom:var(--space-6)">
      {{ gift_card.initial_value | money_without_trailing_zeros }}
    </p>

    {%- unless gift_card.enabled -%}
      <span class="badge badge--ink" style="display:block; margin-bottom:var(--space-4)">
        {{ 'gift_cards.issued.disabled' | t }}
      </span>
    {%- endunless -%}

    {%- if gift_card.expires_on -%}
      <p style="font-size:0.875rem; color:var(--color-sage); margin-bottom:var(--space-4)">
        {{ 'gift_cards.issued.expiry_date' | t: expiry: gift_card.expires_on | date: '%B %d, %Y' }}
      </p>
    {%- endif -%}

    <div style="background:var(--color-fog); border-radius:var(--radius-m); padding:var(--space-5); margin-bottom:var(--space-6)">
      <p style="font-family:monospace; font-size:1.25rem; letter-spacing:0.15em; font-weight:600; word-break:break-all">
        {{ gift_card.code | format_code }}
      </p>
    </div>

    <div id="QrCode" style="margin-bottom:var(--space-6)">
      {{ gift_card.qr_identifier | qr_code }}
    </div>

    <div style="display:flex; flex-direction:column; gap:var(--space-3)">
      <a href="{{ shop.url }}" class="btn btn--primary">
        {{ 'gift_cards.issued.shop_link' | t }}
      </a>
      <button class="btn btn--outline" onclick="window.print()">
        {{ 'gift_cards.issued.print' | t }}
      </button>
    </div>
  </div>
</body>
</html>
