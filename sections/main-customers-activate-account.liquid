<section class="section-padding">
  <div class="container container--xs">
    <h1 class="section-title">Activate Account</h1>
    <p style="margin-bottom:var(--space-6); color:var(--color-sage)">Create a password to activate your account.</p>

    {%- form 'activate_customer_password' -%}
      {%- if form.errors -%}
        <p style="color:#b94040; margin-bottom:var(--space-4)">{{ form.errors | default_errors }}</p>
      {%- endif -%}
      <div class="form-group">
        <label for="ActivatePassword">Password</label>
        <input type="password" name="customer[password]" id="ActivatePassword" required>
      </div>
      <div class="form-group">
        <label for="ActivatePasswordConfirm">Confirm Password</label>
        <input type="password" name="customer[password_confirmation]" id="ActivatePasswordConfirm" required>
      </div>
      <button type="submit" class="btn btn--primary btn--full">Activate Account</button>
    {%- endform -%}
  </div>
</section>

{% schema %}
{
  "name": "Activate Account",
  "settings": []
}
{% endschema %}
