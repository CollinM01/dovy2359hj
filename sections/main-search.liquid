<section class="search-page section-padding">
  <div class="container">
    <div class="search-header">
      <h1 class="section-title">{{ 'templates.search.title' | t }}</h1>
      <form action="{{ routes.search_url }}" method="get" role="search">
        <input type="hidden" name="type" value="product,article,page">
        <div style="display:flex; gap:var(--space-3); max-width:500px; margin-inline:auto">
          <input type="search"
                 name="q"
                 value="{{ search.terms | escape }}"
                 placeholder="{{ 'general.search.placeholder' | t }}"
                 aria-label="{{ 'general.search.search' | t }}"
                 style="flex:1">
          <button type="submit" class="btn btn--primary">{% render 'icon-search' %}</button>
        </div>
      </form>
    </div>

    {%- if search.performed -%}
      {%- if search.results_count == 0 -%}
        <p class="search-results-count text-center">{{ 'templates.search.no_results' | t: terms: search.terms }}</p>
      {%- else -%}
        <p class="search-results-count text-center" style="margin-bottom:var(--space-8)">
          {{ 'general.search.results_with_count' | t: count: search.results_count, terms: search.terms }}
        </p>
        {%- paginate search.results by 12 -%}
          <div class="products-grid products-grid--3-col">
            {%- for item in search.results -%}
              {%- if item.object_type == 'product' -%}
                {% render 'product-card', product: item %}
              {%- else -%}
                <div class="card" style="padding: var(--space-6)">
                  <h3 style="margin-bottom:var(--space-3)"><a href="{{ item.url }}">{{ item.title }}</a></h3>
                  {%- if item.excerpt != blank -%}
                    <p style="color:var(--color-sage);font-size:0.9rem">{{ item.excerpt | strip_html | truncate: 120 }}</p>
                  {%- endif -%}
                  <a href="{{ item.url }}" class="btn btn--outline" style="margin-top:var(--space-4);font-size:0.8rem">Read More</a>
                </div>
              {%- endif -%}
            {%- endfor -%}
          </div>
          {%- if paginate.pages > 1 -%}
            {% render 'pagination', paginate: paginate %}
          {%- endif -%}
        {%- endpaginate -%}
      {%- endif -%}
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Search Results",
  "settings": []
}
{% endschema %}
