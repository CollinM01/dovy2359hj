<div class="page-about">
  <section class="about-hero section-padding">
    <div class="container container--narrow">
      {%- if section.settings.hero_image != blank -%}
        <div class="about-hero__image">
          <img src="{{ section.settings.hero_image | image_url: width: 1400 }}"
               srcset="{{ section.settings.hero_image | image_url: width: 700 }} 700w, {{ section.settings.hero_image | image_url: width: 1400 }} 1400w"
               sizes="100vw"
               alt="{{ section.settings.hero_image.alt | escape }}"
               loading="eager">
        </div>
      {%- endif -%}
      <div class="about-hero__content">
        <h1 class="about-title">{{ section.settings.title | default: page.title }}</h1>
        {%- if section.settings.intro != blank -%}
          <div class="about-intro rte">{{ section.settings.intro }}</div>
        {%- endif -%}
      </div>
    </div>
  </section>

  <section class="mel-story section-padding">
    <div class="container container--narrow">
      <div class="mel-story__inner">
        {%- if section.settings.mel_image != blank -%}
          <div class="mel-story__image">
            <img src="{{ section.settings.mel_image | image_url: width: 600 }}"
                 alt="{{ section.settings.mel_image.alt | escape }}"
                 loading="lazy">
          </div>
        {%- endif -%}
        <div class="mel-story__content">
          {%- if section.settings.mel_title != blank -%}
            <h2>{{ section.settings.mel_title }}</h2>
          {%- endif -%}
          {%- if section.settings.mel_body != blank -%}
            <div class="rte">{{ section.settings.mel_body }}</div>
          {%- endif -%}
        </div>
      </div>
    </div>
  </section>

  <section class="profiles-section section-padding" style="background: var(--color-cream)">
    <div class="container">
      <h2 class="section-title text-center">{{ section.settings.profiles_title | default: 'Meet the Team' }}</h2>
      <div class="profiles-grid">
        {%- for block in section.blocks -%}
          {%- if block.type == 'profile' -%}
            <div class="profile-card" {{ block.shopify_attributes }}>
              {%- if block.settings.image != blank -%}
                <div class="profile-card__image">
                  <img src="{{ block.settings.image | image_url: width: 400 }}"
                       alt="{{ block.settings.name | escape }}"
                       loading="lazy">
                </div>
              {%- else -%}
                <div class="profile-card__image profile-card__image--placeholder">
                  {{ 'image' | placeholder_svg_tag }}
                </div>
              {%- endif -%}
              <div class="profile-card__info">
                <h3 class="profile-card__name">{{ block.settings.name }}</h3>
                <p class="profile-card__role">{{ block.settings.role }}</p>
                {%- if block.settings.bio != blank -%}
                  <div class="profile-card__bio rte">{{ block.settings.bio }}</div>
                {%- endif -%}
              </div>
            </div>
          {%- endif -%}
        {%- endfor -%}
      </div>
    </div>
  </section>

  {%- if page.content != blank -%}
    <section class="about-content section-padding">
      <div class="container container--narrow rte">
        {{ page.content }}
      </div>
    </section>
  {%- endif -%}
</div>

{% schema %}
{
  "name": "About Page",
  "settings": [
    {
      "type": "image_picker",
      "id": "hero_image",
      "label": "Hero image"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Hero title"
    },
    {
      "type": "richtext",
      "id": "intro",
      "label": "Intro text"
    },
    {
      "type": "image_picker",
      "id": "mel_image",
      "label": "Mel photo"
    },
    {
      "type": "text",
      "id": "mel_title",
      "label": "Mel section title",
      "default": "About Mel"
    },
    {
      "type": "richtext",
      "id": "mel_body",
      "label": "Mel story text"
    },
    {
      "type": "text",
      "id": "profiles_title",
      "label": "Profiles section title",
      "default": "Meet Atlas & Peabody"
    }
  ],
  "blocks": [
    {
      "type": "profile",
      "name": "Profile Card",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Photo"
        },
        {
          "type": "text",
          "id": "name",
          "label": "Name",
          "default": "Atlas"
        },
        {
          "type": "text",
          "id": "role",
          "label": "Role / Title",
          "default": "Brand Mascot"
        },
        {
          "type": "richtext",
          "id": "bio",
          "label": "Bio"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "About Page",
      "blocks": [
        { "type": "profile", "settings": { "name": "Atlas", "role": "Chief Adventure Officer" } },
        { "type": "profile", "settings": { "name": "Peabody", "role": "Head of Napping & Quality Control" } }
      ]
    }
  ]
}
{% endschema %}
