<section class="section-padding">
  <div class="container">
    <a href="{{ routes.account_url }}" class="btn btn--outline" style="font-size:0.85rem; margin-bottom:var(--space-6)">
      {% render 'icon-arrow' %} {{ 'customers.order.back_to_account' | t }}
    </a>

    <h1 class="section-title">Order {{ order.name }}</h1>
    <p style="color:var(--color-sage); margin-bottom:var(--space-8)">Placed {{ order.created_at | date: '%B %d, %Y' }}</p>

    <div style="display:grid; grid-template-columns: 1fr 1fr; gap:var(--space-8)">
      <div>
        <h2 style="font-size:1.125rem; margin-bottom:var(--space-4)">{{ 'customers.order.billing_address' | t }}</h2>
        <address style="font-style:normal; font-size:0.9rem; line-height:1.7">
          {{ order.billing_address.name }}<br>
          {{ order.billing_address.address1 }}<br>
          {%- if order.billing_address.address2 != blank -%}{{ order.billing_address.address2 }}<br>{%- endif -%}
          {{ order.billing_address.city }}, {{ order.billing_address.province_code }} {{ order.billing_address.zip }}<br>
          {{ order.billing_address.country }}
        </address>
      </div>
      <div>
        <h2 style="font-size:1.125rem; margin-bottom:var(--space-4)">{{ 'customers.order.shipping_address' | t }}</h2>
        <address style="font-style:normal; font-size:0.9rem; line-height:1.7">
          {{ order.shipping_address.name }}<br>
          {{ order.shipping_address.address1 }}<br>
          {%- if order.shipping_address.address2 != blank -%}{{ order.shipping_address.address2 }}<br>{%- endif -%}
          {{ order.shipping_address.city }}, {{ order.shipping_address.province_code }} {{ order.shipping_address.zip }}<br>
          {{ order.shipping_address.country }}
        </address>
      </div>
    </div>

    <table style="width:100%; border-collapse:collapse; font-size:0.9rem; margin-top:var(--space-8)">
      <thead>
        <tr style="border-bottom: 2px solid var(--color-fog)">
          <th style="padding:var(--space-2) 0; text-align:left">Product</th>
          <th style="padding:var(--space-2); text-align:center">Qty</th>
          <th style="padding:var(--space-2) 0; text-align:right">Price</th>
        </tr>
      </thead>
      <tbody>
        {%- for line_item in order.line_items -%}
          <tr style="border-bottom: 1px solid var(--color-fog)">
            <td style="padding:var(--space-4) 0">
              <strong>{{ line_item.title }}</strong>
              {%- if line_item.variant.title != 'Default Title' -%}
                <br><span style="color:var(--color-sage)">{{ line_item.variant.title }}</span>
              {%- endif -%}
            </td>
            <td style="padding:var(--space-4); text-align:center">{{ line_item.quantity }}</td>
            <td style="padding:var(--space-4) 0; text-align:right">{{ line_item.final_line_price | money }}</td>
          </tr>
        {%- endfor -%}
      </tbody>
      <tfoot>
        <tr>
          <td colspan="2" style="padding:var(--space-3) 0; text-align:right; color:var(--color-sage)">Subtotal</td>
          <td style="padding:var(--space-3) 0; text-align:right">{{ order.line_items_subtotal_price | money }}</td>
        </tr>
        {%- for shipping in order.shipping_methods -%}
          <tr>
            <td colspan="2" style="padding:var(--space-2) 0; text-align:right; color:var(--color-sage)">Shipping ({{ shipping.title }})</td>
            <td style="padding:var(--space-2) 0; text-align:right">{{ shipping.price | money }}</td>
          </tr>
        {%- endfor -%}
        <tr style="border-top: 2px solid var(--color-fog)">
          <td colspan="2" style="padding:var(--space-3) 0; text-align:right; font-weight:600">Total</td>
          <td style="padding:var(--space-3) 0; text-align:right; font-weight:600">{{ order.total_price | money }}</td>
        </tr>
      </tfoot>
    </table>
  </div>
</section>

{% schema %}
{
  "name": "Customer Order",
  "settings": []
}
{% endschema %}
