<section class="rich-text-section section-padding" style="background: {{ section.settings.bg_color }}">
  <div class="container">
    <div class="rich-text-section__inner">
      {%- if section.settings.heading != blank -%}
        <h2 class="rich-text-section__heading">{{ section.settings.heading }}</h2>
      {%- endif -%}
      {%- if section.settings.content != blank -%}
        <div class="rte">{{ section.settings.content }}</div>
      {%- endif -%}
      {%- if section.settings.button_label != blank -%}
        <div style="margin-top: var(--space-8)">
          <a href="{{ section.settings.button_link }}" class="btn btn--primary">
            {{ section.settings.button_label }}
          </a>
        </div>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Rich Text",
  "settings": [
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background color",
      "default": "#faf7f2"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading"
    },
    {
      "type": "richtext",
      "id": "content",
      "label": "Content"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    }
  ],
  "presets": [
    {
      "name": "Rich Text"
    }
  ]
}
{% endschema %}
