<section class="section-padding">
  <div class="container container--xs">
    <h1 class="section-title">{{ 'customers.login.title' | t }}</h1>

    {%- form 'customer_login' -%}
      {%- if form.errors -%}
        <p style="color:#b94040; margin-bottom:var(--space-4); font-size:0.9rem">{{ form.errors | default_errors }}</p>
      {%- endif -%}
      <div class="form-group">
        <label for="CustomerEmail">{{ 'customers.login.email' | t }}</label>
        <input type="email" name="customer[email]" id="CustomerEmail" autocomplete="email" required>
      </div>
      <div class="form-group">
        <label for="CustomerPassword">{{ 'customers.login.password' | t }}</label>
        <input type="password" name="customer[password]" id="CustomerPassword" autocomplete="current-password" required>
      </div>
      <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:var(--space-4)">
        <a href="{{ routes.root_url }}account/login#recover">{{ 'customers.login.forgot_password' | t }}</a>
      </div>
      <button type="submit" class="btn btn--primary btn--full">{{ 'customers.login.sign_in' | t }}</button>
    {%- endform -%}

    <p style="margin-top:var(--space-6); text-align:center">
      {{ 'customers.login.no_account' | t }}
      <a href="{{ routes.account_register_url }}">{{ 'customers.login.create_account' | t }}</a>
    </p>
  </div>
</section>

{% schema %}
{
  "name": "Customer Login",
  "settings": []
}
{% endschema %}
