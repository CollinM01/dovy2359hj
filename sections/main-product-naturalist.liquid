<section class="section container product-page" data-product-page>
  <div class="product-page__gallery">
    <div class="product-main-image" data-main-image>
      {% if product.featured_media %}
        {{ product.featured_media | image_url: width: 1400 | image_tag: alt: product.title, loading: 'eager' }}
      {% endif %}
    </div>
    <div class="product-thumbs">
      {% for media in product.media %}
        <button type="button" class="thumb" data-image-url="{{ media | image_url: width: 1400 }}" {% if forloop.first %}aria-current="true"{% endif %}>
          {{ media | image_url: width: 240 | image_tag: loading: 'lazy', alt: product.title }}
        </button>
      {% endfor %}
    </div>
  </div>

  <div class="product-page__content">
    <p class="eyebrow">{{ product.vendor }}</p>
    <h1>{{ product.title }}</h1>
    {% render 'price', product: product %}
    <p>{{ product.description | strip_html | truncate: 160 }}</p>

    {% form 'product', product, class: 'product-form', data-product-form: true %}
      <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">
      {% render 'variant-selectors', product: product %}

      <div class="quantity-control">
        <button type="button" data-qty-change="-1">−</button>
        <input type="number" name="quantity" min="1" value="1">
        <button type="button" data-qty-change="1">+</button>
      </div>

      <button type="submit" class="button" {% unless product.available %}disabled{% endunless %}>
        {% if product.available %}{{ 'general.add_to_cart' | t }}{% else %}Sold out{% endif %}
      </button>
    {% endform %}

    {% render 'accordion', title: 'Description', content: product.description, open: true %}
    {% render 'accordion', title: 'Features', content: product.metafields.custom.features | default: 'Soft-touch fabric, durable stitchwork, and field-tested comfort.' %}
    {% render 'accordion', title: 'Care', content: product.metafields.custom.care | default: 'Machine wash cold, tumble dry low, do not bleach.' %}
    {% render 'accordion', title: 'Shipping', content: product.metafields.custom.shipping | default: 'Ships in 1–3 business days. Free shipping threshold configurable in Shopify.' %}
  </div>
</section>

{% schema %}
{ "name": "Main product naturalist", "settings": [] }
{% endschema %}
