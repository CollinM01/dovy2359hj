<product-form>
  <div class="product-page container">
    <div class="product-gallery-wrapper">
      <product-media-gallery id="MediaGallery-{{ section.id }}" class="product-gallery">
        <div class="product-gallery__main">
          {%- for media in product.media -%}
            <div class="product-gallery__item{% if forloop.first %} active{% endif %}"
                 id="Media-{{ media.id }}"
                 data-media-id="{{ media.id }}">
              {%- if media.media_type == 'image' -%}
                <img src="{{ media | image_url: width: 1200 }}"
                     srcset="{{ media | image_url: width: 600 }} 600w,
                             {{ media | image_url: width: 900 }} 900w,
                             {{ media | image_url: width: 1200 }} 1200w"
                     sizes="(max-width: 768px) 100vw, 50vw"
                     alt="{{ media.alt | escape }}"
                     width="{{ media.width }}"
                     height="{{ media.height }}"
                     loading="{% if forloop.first %}eager{% else %}lazy{% endif %}">
              {%- endif -%}
            </div>
          {%- else -%}
            <div class="product-gallery__item active">
              {{ 'product-1' | placeholder_svg_tag: 'product-gallery__placeholder' }}
            </div>
          {%- endfor -%}
        </div>

        {%- if product.media.size > 1 -%}
          <div class="product-gallery__thumbnails">
            {%- for media in product.media -%}
              <button class="product-thumbnail{% if forloop.first %} active{% endif %}"
                      data-target-media="{{ media.id }}"
                      aria-label="{{ media.alt | default: product.title | escape }}">
                <img src="{{ media | image_url: width: 120 }}"
                     alt="{{ media.alt | escape }}"
                     width="120" height="120"
                     loading="lazy">
              </button>
            {%- endfor -%}
          </div>
        {%- endif -%}
      </product-media-gallery>
    </div>

    <div class="product-info">
      <div class="product-info__sticky">
        {%- if section.settings.show_vendor -%}
          <p class="product-vendor">{{ product.vendor }}</p>
        {%- endif -%}
        <h1 class="product-title">{{ product.title }}</h1>

        {%- assign current_variant = product.selected_or_first_available_variant -%}
        <div class="product-price" id="price-{{ section.id }}">
          {% render 'price', product: product, use_variant: true, show_badges: true %}
        </div>

        <form method="post" action="/cart/add"
              id="product-form-{{ section.id }}"
              data-product-id="{{ product.id }}"
              data-section-id="{{ section.id }}">
          <input type="hidden" name="form_type" value="product">
          <input type="hidden" name="utf8" value="✓">
          <input type="hidden" name="id" id="variant-id-{{ section.id }}" value="{{ current_variant.id }}">

          {%- comment -%} Variant data for product-form.js {%- endcomment -%}
          <script id="ProductVariants-{{ section.id }}" type="application/json">
            {{ product.variants | json }}
          </script>

          {% render 'variant-selectors', product: product, section: section %}

          {%- if section.settings.show_quantity -%}
            <div class="product-qty-row">
              <label for="Quantity-{{ section.id }}" class="visually-hidden">{{ 'products.product.quantity' | t }}</label>
              <quantity-input class="qty-stepper">
                <button type="button" class="qty-stepper__btn" name="minus" aria-label="Decrease quantity">
                  {% render 'icon-minus' %}
                </button>
                <input type="number"
                       id="Quantity-{{ section.id }}"
                       name="quantity"
                       value="1"
                       min="1"
                       class="qty-stepper__input"
                       aria-label="{{ 'products.product.quantity' | t }}">
                <button type="button" class="qty-stepper__btn" name="plus" aria-label="Increase quantity">
                  {% render 'icon-plus' %}
                </button>
              </quantity-input>
            </div>
          {%- endif -%}

          <button type="submit"
                  id="atc-{{ section.id }}"
                  class="btn btn--primary btn--full atc-btn"
                  {% unless current_variant.available %}disabled{% endunless %}>
            <span class="atc-btn__text">
              {%- if current_variant.available -%}
                {{ 'products.product.add_to_cart' | t }}
              {%- else -%}
                {{ 'products.product.sold_out' | t }}
              {%- endif -%}
            </span>
            <span class="atc-btn__loader" aria-hidden="true">
              {% render 'icon-loader' %}
            </span>
          </button>
        </form>

        <div class="product-accordions">
          {%- if product.description != blank -%}
            {% render 'accordion',
               id: 'desc',
               title: 'Description',
               content: product.description,
               open: true %}
          {%- endif -%}
          {%- if product.metafields.custom.features != blank -%}
            {% render 'accordion',
               id: 'feat',
               title: 'Features & Materials',
               content: product.metafields.custom.features | metafield_tag %}
          {%- endif -%}
          {%- if product.metafields.custom.care != blank -%}
            {% render 'accordion',
               id: 'care',
               title: 'Care Instructions',
               content: product.metafields.custom.care | metafield_tag %}
          {%- endif -%}
          {%- assign shipping_content = product.metafields.custom.shipping | default: settings.shipping_policy_text -%}
          {%- if shipping_content != blank -%}
            {% render 'accordion',
               id: 'ship',
               title: 'Shipping & Returns',
               content: shipping_content %}
          {%- endif -%}
        </div>
      </div>
    </div>
  </div>
</product-form>

{% schema %}
{
  "name": "Product - Naturalist",
  "settings": [
    {
      "type": "checkbox",
      "id": "show_vendor",
      "label": "Show vendor",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_quantity",
      "label": "Show quantity selector",
      "default": true
    }
  ]
}
{% endschema %}
