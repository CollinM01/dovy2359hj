<section class="conservation-banner section-padding">
  {%- if section.settings.image != blank -%}
    <div class="conservation-banner__media">
      <img src="{{ section.settings.image | image_url: width: 2000 }}"
           srcset="{{ section.settings.image | image_url: width: 750 }} 750w, {{ section.settings.image | image_url: width: 1500 }} 1500w, {{ section.settings.image | image_url: width: 2000 }} 2000w"
           sizes="100vw"
           alt="{{ section.settings.image.alt | escape }}"
           loading="lazy"
           width="{{ section.settings.image.width }}"
           height="{{ section.settings.image.height }}">
      <div class="conservation-banner__overlay" style="opacity: {{ section.settings.overlay_opacity | divided_by: 100.0 }}"></div>
    </div>
  {%- else -%}
    <div class="conservation-banner__overlay" style="opacity: 1"></div>
  {%- endif -%}

  <div class="conservation-banner__content">
    {%- if section.settings.eyebrow != blank -%}
      <p class="conservation-banner__eyebrow">{{ section.settings.eyebrow }}</p>
    {%- endif -%}
    <h2 class="conservation-banner__title">{{ section.settings.title }}</h2>
    {%- if section.settings.subtitle != blank -%}
      <p class="conservation-banner__subtitle">{{ section.settings.subtitle }}</p>
    {%- endif -%}
    {%- if section.settings.button_label != blank -%}
      <a href="{{ section.settings.button_link | default: '/pages/conservation' }}" class="btn btn--primary">
        {{ section.settings.button_label }}
      </a>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Conservation Banner",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Background image"
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "min": 0,
      "max": 90,
      "step": 5,
      "label": "Overlay opacity %",
      "default": 55
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow text",
      "default": "1% for Conservation"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "Wild Places Need Champions"
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "Subheading",
      "default": "1% of every purchase goes to Pacific Northwest conservation efforts."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Learn More"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    }
  ],
  "presets": [
    {
      "name": "Conservation Banner"
    }
  ]
}
{% endschema %}
