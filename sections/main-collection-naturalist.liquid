<section class="collection-page section-padding">
  <div class="container">
    <header class="collection-header">
      <h1 class="collection-title">{{ collection.title }}</h1>
      {%- if section.settings.show_description and collection.description != blank -%}
        <div class="collection-description rte">{{ collection.description }}</div>
      {%- endif -%}
      <p class="collection-count">{{ collection.products_count }} items</p>
    </header>

    {%- if section.settings.show_tabs -%}
      <div class="collection-tabs" role="tablist" aria-label="Collection filters">
        {%- assign tabs = 'all,hoodies,sweatshirts,t-shirts' | split: ',' -%}
        {%- assign tab_labels = 'All,Hoodies,Sweatshirts,T-Shirts' | split: ',' -%}
        {%- for tab in tabs -%}
          {%- assign tab_label = tab_labels[forloop.index0] -%}
          {%- assign tab_handle = tab -%}
          <a href="{% if tab == 'all' %}/collections/all{% else %}/collections/{{ tab_handle }}{% endif %}"
             class="collection-tab{% if collection.handle == tab_handle or (tab == 'all' and collection.handle == 'all') %} collection-tab--active{% endif %}"
             role="tab"
             aria-selected="{{ collection.handle == tab_handle }}">
            {{ tab_label }}
          </a>
        {%- endfor -%}
      </div>
    {%- endif -%}

    {%- paginate collection.products by section.settings.products_per_page -%}
      <div class="products-grid products-grid--3-col" id="product-grid">
        {%- for product in collection.products -%}
          {% render 'product-card', product: product %}
        {%- else -%}
          <div class="collection-empty">
            <p>No products found in this collection.</p>
          </div>
        {%- endfor -%}
      </div>
      {%- if paginate.pages > 1 -%}
        {% render 'pagination', paginate: paginate %}
      {%- endif -%}
    {%- endpaginate -%}
  </div>
</section>

{% schema %}
{
  "name": "Collection - Naturalist",
  "settings": [
    {
      "type": "range",
      "id": "products_per_page",
      "min": 8,
      "max": 48,
      "step": 4,
      "label": "Products per page",
      "default": 12
    },
    {
      "type": "checkbox",
      "id": "show_description",
      "label": "Show collection description",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_tabs",
      "label": "Show collection tabs",
      "default": true
    }
  ]
}
{% endschema %}
