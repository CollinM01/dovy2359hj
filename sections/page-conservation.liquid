<section class="section container prose-page">
  <p class="eyebrow">{{ section.settings.eyebrow }}</p>
  <h1>{{ section.settings.heading }}</h1>
  <p>{{ section.settings.body }}</p>
  <ul>
    <li>1% revenue allocation to habitat and wildlife projects.</li>
    <li>Priority sourcing for durable, longer-lasting garments.</li>
    <li>Community education through field-note storytelling.</li>
  </ul>
</section>

{% schema %}
{
  "name": "Page conservation",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Conservation" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Protecting Pacific Northwest habitats" },
    { "type": "textarea", "id": "body", "label": "Body", "default": "Every drop supports stewardship for birds, forests, and coastal ecosystems." }
  ]
}
{% endschema %}
