<div class="page-conservation">
  <section class="conservation-hero section-padding" style="background: var(--color-moss); color: var(--color-paper)">
    <div class="container container--narrow" style="text-align:center">
      {%- if section.settings.hero_image != blank -%}
        <div style="margin-bottom: var(--space-8); border-radius: var(--radius-md); overflow: hidden">
          <img src="{{ section.settings.hero_image | image_url: width: 1400 }}"
               alt="{{ section.settings.hero_image.alt | escape }}"
               style="width:100%; max-height:50vh; object-fit:cover"
               loading="eager">
        </div>
      {%- endif -%}
      {%- if section.settings.eyebrow != blank -%}
        <p style="font-size:0.75rem;font-weight:600;letter-spacing:0.18em;text-transform:uppercase;opacity:0.75;margin-bottom:var(--space-4)">{{ section.settings.eyebrow }}</p>
      {%- endif -%}
      <h1 style="color: var(--color-paper); font-size: clamp(2rem,5vw,4rem); font-weight:300; margin-bottom: var(--space-5)">{{ section.settings.title | default: page.title }}</h1>
      {%- if section.settings.intro != blank -%}
        <div class="rte" style="color: rgba(245,240,232,0.85); font-size:1.1rem; line-height:1.75; max-width:640px; margin-inline:auto">{{ section.settings.intro }}</div>
      {%- endif -%}
    </div>
  </section>

  <section class="section-padding" style="background: var(--color-cream)">
    <div class="container">
      <h2 class="section-title text-center">{{ section.settings.values_title | default: 'Our Commitments' }}</h2>
      <div class="conservation-values">
        {%- for block in section.blocks -%}
          {%- if block.type == 'value' -%}
            <div class="value-card" {{ block.shopify_attributes }}>
              {%- if block.settings.icon != blank -%}
                <div class="value-card__icon">{{ block.settings.icon }}</div>
              {%- endif -%}
              <h3 class="value-card__title">{{ block.settings.title }}</h3>
              {%- if block.settings.body != blank -%}
                <div class="value-card__body rte">{{ block.settings.body }}</div>
              {%- endif -%}
            </div>
          {%- endif -%}
        {%- endfor -%}
      </div>
    </div>
  </section>

  {%- if section.settings.commitment != blank -%}
    <section class="section-padding" style="background: var(--color-paper); text-align:center">
      <div class="container container--narrow rte">
        {{ section.settings.commitment }}
      </div>
    </section>
  {%- endif -%}

  {%- if page.content != blank -%}
    <section class="section-padding">
      <div class="container container--narrow rte">
        {{ page.content }}
      </div>
    </section>
  {%- endif -%}
</div>

{% schema %}
{
  "name": "Conservation Page",
  "settings": [
    {
      "type": "image_picker",
      "id": "hero_image",
      "label": "Hero image"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "1% for Conservation"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Hero title",
      "default": "Wild Places Need Champions"
    },
    {
      "type": "richtext",
      "id": "intro",
      "label": "Intro text",
      "default": "<p>1% of every Atlas Dovy purchase goes directly to organizations protecting the wild places that inspire us.</p>"
    },
    {
      "type": "text",
      "id": "values_title",
      "label": "Values section title",
      "default": "Our Commitments"
    },
    {
      "type": "richtext",
      "id": "commitment",
      "label": "Commitment statement"
    }
  ],
  "blocks": [
    {
      "type": "value",
      "name": "Value Item",
      "settings": [
        {
          "type": "text",
          "id": "icon",
          "label": "Emoji / Icon",
          "default": "🌲"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Forest Preservation"
        },
        {
          "type": "richtext",
          "id": "body",
          "label": "Description"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Conservation Page",
      "blocks": [
        { "type": "value", "settings": { "icon": "🌲", "title": "Forest Preservation", "body": "<p>Supporting old-growth preservation and reforestation efforts across the Pacific Northwest.</p>" } },
        { "type": "value", "settings": { "icon": "🐺", "title": "Wildlife Corridors", "body": "<p>Funding the creation and maintenance of safe wildlife movement corridors.</p>" } },
        { "type": "value", "settings": { "icon": "💧", "title": "Clean Water", "body": "<p>Partnering with watershed restoration programs to keep rivers and streams healthy.</p>" } },
        { "type": "value", "settings": { "icon": "♻️", "title": "Sustainable Materials", "body": "<p>Using recycled and organic materials whenever possible in all our products.</p>" } }
      ]
    }
  ]
}
{% endschema %}
