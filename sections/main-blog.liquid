<section class="section-padding">
  <div class="container">
    <header class="section-header">
      <h1 class="section-title">{{ blog.title }}</h1>
    </header>
    {%- paginate blog.articles by 9 -%}
      <div class="articles-grid">
        {%- for article in blog.articles -%}
          <article class="article-card">
            {%- if article.image -%}
              <div class="article-card__image">
                <a href="{{ article.url }}">
                  <img src="{{ article.image | image_url: width: 800 }}"
                       srcset="{{ article.image | image_url: width: 400 }} 400w, {{ article.image | image_url: width: 800 }} 800w"
                       sizes="(max-width: 768px) 50vw, 33vw"
                       alt="{{ article.image.alt | default: article.title | escape }}"
                       loading="lazy">
                </a>
              </div>
            {%- endif -%}
            <p class="article-card__meta">{{ article.published_at | date: '%B %d, %Y' }}</p>
            <h2 class="article-card__title">
              <a href="{{ article.url }}">{{ article.title }}</a>
            </h2>
            {%- if article.excerpt != blank -%}
              <p class="article-card__excerpt">{{ article.excerpt | strip_html | truncate: 120 }}</p>
            {%- endif -%}
            <a href="{{ article.url }}" class="article-card__link">{{ 'templates.blog.read_more' | t }}</a>
          </article>
        {%- endfor -%}
      </div>
      {%- if paginate.pages > 1 -%}
        {% render 'pagination', paginate: paginate %}
      {%- endif -%}
    {%- endpaginate -%}
  </div>
</section>

{% schema %}
{
  "name": "Blog Articles",
  "settings": []
}
{% endschema %}
