<section class="section-padding">
  <div class="container">
    <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:var(--space-8)">
      <h1 class="section-title" style="margin:0">{{ 'customers.addresses.title' | t }}</h1>
      <button class="btn btn--outline" id="AddNewAddress" onclick="document.getElementById('NewAddressForm').removeAttribute('hidden')">
        {{ 'customers.addresses.add_new' | t }}
      </button>
    </div>

    <div id="NewAddressForm" hidden style="background:var(--color-cream); padding:var(--space-6); margin-bottom:var(--space-8); border-radius:var(--radius-m)">
      <h2 style="font-size:1.125rem; margin-bottom:var(--space-4)">{{ 'customers.addresses.add_new' | t }}</h2>
      {%- form 'customer_address', customer.new_address -%}
        {% render 'address-fields', form: form %}
        <div style="display:flex; gap:var(--space-3); margin-top:var(--space-4)">
          <button type="submit" class="btn btn--primary">{{ 'customers.addresses.add' | t }}</button>
          <button type="button" class="btn btn--outline" onclick="document.getElementById('NewAddressForm').setAttribute('hidden','')">Cancel</button>
        </div>
      {%- endform -%}
    </div>

    {%- for address in customer.addresses -%}
      <div class="card" style="padding:var(--space-6); margin-bottom:var(--space-4)">
        {%- if address == customer.default_address -%}
          <span class="badge badge--sage" style="margin-bottom:var(--space-3)">Default</span>
        {%- endif -%}
        <address style="font-style:normal; font-size:0.9rem; line-height:1.7">
          {{ address.name }}<br>
          {{ address.address1 }}<br>
          {%- if address.address2 != blank -%}{{ address.address2 }}<br>{%- endif -%}
          {{ address.city }}, {{ address.province_code }} {{ address.zip }}<br>
          {{ address.country }}
        </address>
        <div style="display:flex; gap:var(--space-3); margin-top:var(--space-4)">
          <button class="btn btn--outline btn--small" onclick="document.getElementById('EditAddress_{{ address.id }}').removeAttribute('hidden')">
            {{ 'customers.addresses.edit' | t }}
          </button>
          <button class="btn btn--outline btn--small"
                  data-confirm-message="{{ 'customers.addresses.delete_confirm' | t }}"
                  onclick="if(confirm(this.dataset.confirmMessage)){Shopify.CustomerAddress.destroy('{{ address.id }}')}">
            {{ 'customers.addresses.delete' | t }}
          </button>
        </div>

        <div id="EditAddress_{{ address.id }}" hidden style="margin-top:var(--space-4)">
          {%- form 'customer_address', address -%}
            {% render 'address-fields', form: form, address: address %}
            <div style="display:flex; gap:var(--space-3); margin-top:var(--space-4)">
              <button type="submit" class="btn btn--primary">{{ 'customers.addresses.update' | t }}</button>
              <button type="button" class="btn btn--outline" onclick="document.getElementById('EditAddress_{{ address.id }}').setAttribute('hidden','')">Cancel</button>
            </div>
          {%- endform -%}
        </div>
      </div>
    {%- endfor -%}
  </div>
</section>

{% schema %}
{
  "name": "Customer Addresses",
  "settings": []
}
{% endschema %}
