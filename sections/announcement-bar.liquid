{% if section.settings.show_announcement %}
<div class="announcement-bar" role="region" aria-label="{{ 'sections.announcement_bar.announcement' | t }}">
  <div class="announcement-bar__message">
    {%- if section.settings.announcement_link != blank -%}
      <a href="{{ section.settings.announcement_link }}">{{ section.settings.announcement_text }}</a>
    {%- else -%}
      {{ section.settings.announcement_text }}
    {%- endif -%}
  </div>
</div>
{% endif %}

{% schema %}
{
  "name": "Announcement Bar",
  "settings": [
    {
      "type": "checkbox",
      "id": "show_announcement",
      "label": "Show announcement",
      "default": true
    },
    {
      "type": "text",
      "id": "announcement_text",
      "label": "Announcement text",
      "default": "Free shipping on orders over $75 — Wild & Free"
    },
    {
      "type": "url",
      "id": "announcement_link",
      "label": "Announcement link"
    }
  ]
}
{% endschema %}
