<div class="password-page">
  <div class="password-page__inner">
    <div class="password-page__logo">
      {%- if settings.logo != blank -%}
        <img src="{{ settings.logo | image_url: width: 200 }}" alt="{{ shop.name }}" width="200">
      {%- else -%}
        {{ shop.name }}
      {%- endif -%}
    </div>

    <h1 class="password-page__title">{{ 'general.password_page.opening_soon' | t }}</h1>
    <p class="password-page__body">Our store is under construction. Check back soon or enter the password below.</p>

    {%- form 'storefront_password' -%}
      {%- if form.errors -%}
        <p style="color:#b94040; margin-bottom:var(--space-4); font-size:0.9rem">Wrong password. Please try again.</p>
      {%- endif -%}
      <div class="form-group">
        <label for="Password">{{ 'general.password_page.login_form_password_label' | t }}</label>
        <input type="password"
               name="password"
               id="Password"
               placeholder="{{ 'general.password_page.login_form_password_placeholder' | t }}"
               required>
      </div>
      <button type="submit" class="btn btn--primary btn--full">
        {{ 'general.password_page.login_form_submit' | t }}
      </button>
    {%- endform -%}

    <p style="margin-top:var(--space-6); font-size:0.8rem; color:var(--color-sage)">
      {{ 'general.password_page.admin_link_html' | t }}
    </p>
  </div>
</div>

{% schema %}
{
  "name": "Password Page",
  "settings": []
}
{% endschema %}
