<cart-drawer id="CartDrawer" class="cart-drawer" aria-label="{{ 'cart.title' | t }}" aria-hidden="true" role="dialog" aria-modal="true">
  <div class="cart-drawer__overlay" data-close-cart></div>
  <div class="cart-drawer__panel">
    <div class="cart-drawer__header">
      <h2 class="cart-drawer__title">{{ 'cart.title' | t }}</h2>
      <button class="cart-drawer__close" data-close-cart aria-label="{{ 'accessibility.close_cart' | t }}">
        {% render 'icon-close' %}
      </button>
    </div>

    <div class="cart-drawer__body">
      <cart-drawer-items id="CartDrawer-Items">
        {%- if cart.item_count == 0 -%}
          <div class="cart-drawer__empty">
            <p>{{ 'cart.empty' | t }}</p>
            <a href="/collections/all" class="btn btn--primary" data-close-cart>Shop Now</a>
          </div>
        {%- else -%}
          {%- for item in cart.items -%}
            {% render 'cart-drawer-item', item: item %}
          {%- endfor -%}
        {%- endif -%}
      </cart-drawer-items>
    </div>

    <div class="cart-drawer__footer" id="CartDrawer-Footer">
      {%- if cart.item_count > 0 -%}
        <div class="cart-drawer__subtotal">
          <span>{{ 'cart.subtotal' | t }}</span>
          <span>{{ cart.total_price | money }}</span>
        </div>
        <p class="cart-drawer__tax-note">{{ 'cart.taxes_and_shipping_at_checkout' | t }}</p>
        <a href="/checkout" class="btn btn--primary btn--full">{{ 'cart.checkout' | t }}</a>
        <a href="/cart" class="btn btn--ghost btn--full cart-drawer__view-cart">{{ 'cart.view_cart' | t }}</a>
      {%- endif -%}
    </div>
  </div>
</cart-drawer>

{% schema %}
{
  "name": "Cart Drawer",
  "settings": []
}
{% endschema %}
