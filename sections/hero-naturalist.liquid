<section class="hero-naturalist" style="--hero-height: {{ section.settings.height }}vh">
  <div class="hero__media">
    {%- if section.settings.image != blank -%}
      <img class="hero__image"
           src="{{ section.settings.image | image_url: width: 2000 }}"
           srcset="{{ section.settings.image | image_url: width: 750 }} 750w,
                   {{ section.settings.image | image_url: width: 1100 }} 1100w,
                   {{ section.settings.image | image_url: width: 1500 }} 1500w,
                   {{ section.settings.image | image_url: width: 2000 }} 2000w"
           sizes="100vw"
           width="{{ section.settings.image.width }}"
           height="{{ section.settings.image.height }}"
           alt="{{ section.settings.image.alt | escape }}"
           loading="eager"
           fetchpriority="high">
    {%- else -%}
      <svg class="hero__placeholder" viewBox="0 0 1600 900" role="img" aria-label="Pacific Northwest mountain landscape">
        <defs>
          <linearGradient id="heroSky" x1="0" y1="0" x2="0" y2="1">
            <stop offset="0%" stop-color="#b8d2df"/>
            <stop offset="100%" stop-color="#e8eff3"/>
          </linearGradient>
          <linearGradient id="heroWater" x1="0" y1="0" x2="0" y2="1">
            <stop offset="0%" stop-color="#6f97ad"/>
            <stop offset="100%" stop-color="#4f7287"/>
          </linearGradient>
        </defs>
        <rect width="1600" height="900" fill="url(#heroSky)"/>
        <path d="M0 430L220 360L420 395L620 300L830 350L1030 280L1240 355L1420 320L1600 390V900H0Z" fill="#5f7f8e"/>
        <path d="M0 520L200 470L430 520L620 450L830 520L1050 470L1290 530L1600 490V900H0Z" fill="#3e5d6b"/>
        <path d="M0 615L260 570L560 645L860 585L1150 655L1420 605L1600 655V900H0Z" fill="#2a3f4b"/>
        <path d="M0 645C220 615 390 625 560 640C760 658 980 692 1180 680C1370 670 1490 650 1600 642V900H0Z" fill="url(#heroWater)"/>
        <path d="M0 705C170 675 350 705 520 740C720 780 950 810 1170 798C1360 788 1480 760 1600 740V900H0Z" fill="#274252"/>
        <path d="M0 760L170 705L340 760L510 710L680 770L850 720L1020 780L1190 730L1360 790L1600 730V900H0Z" fill="#182c37"/>
      </svg>
    {%- endif -%}
    <div class="hero__overlay" style="opacity: {{ section.settings.overlay_opacity | divided_by: 100.0 }}"></div>
  </div>

  <div class="hero__content container">
    {%- if section.settings.eyebrow != blank -%}
      <p class="hero__eyebrow">{{ section.settings.eyebrow }}</p>
    {%- endif -%}
    <h1 class="hero__title">{{ section.settings.title }}</h1>
    {%- if section.settings.subtitle != blank -%}
      <p class="hero__subtitle">{{ section.settings.subtitle }}</p>
    {%- endif -%}
    {%- if section.settings.button_label != blank -%}
      <a href="{{ section.settings.button_link | default: '/collections/all' }}"
         class="btn btn--primary hero__cta">
        {{ section.settings.button_label }}
      </a>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Hero - Naturalist",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Hero image"
    },
    {
      "type": "range",
      "id": "height",
      "min": 40,
      "max": 100,
      "step": 5,
      "unit": "vh",
      "label": "Hero height",
      "default": 85
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "min": 0,
      "max": 80,
      "step": 5,
      "label": "Overlay opacity %",
      "default": 30
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow text",
      "default": "Pacific Northwest"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "Vast landscapes. Everyday layers."
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "Subheading",
      "default": "Built for coastlines, rain shadows, alpine air, and long forest roads."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Explore collection"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    }
  ],
  "presets": [
    {
      "name": "Hero - Naturalist"
    }
  ]
}
{% endschema %}
