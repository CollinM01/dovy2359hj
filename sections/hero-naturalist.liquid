<section class="hero-naturalist{% if section.settings.show_bird_panel %} hero-naturalist--split{% endif %}"
         style="--hero-height: {{ section.settings.height }}vh">
  <div class="hero__media">
    {%- if section.settings.image != blank -%}
      <img class="hero__image"
           src="{{ section.settings.image | image_url: width: 2000 }}"
           srcset="{{ section.settings.image | image_url: width: 750 }} 750w,
                   {{ section.settings.image | image_url: width: 1100 }} 1100w,
                   {{ section.settings.image | image_url: width: 1500 }} 1500w,
                   {{ section.settings.image | image_url: width: 2000 }} 2000w"
           sizes="100vw"
           width="{{ section.settings.image.width }}"
           height="{{ section.settings.image.height }}"
           alt="{{ section.settings.image.alt | escape }}"
           loading="eager"
           fetchpriority="high">
    {%- else -%}
      <div class="hero__placeholder hero__placeholder--birds" aria-hidden="true">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1440 810" preserveAspectRatio="xMidYMid slice" style="display:block;width:100%;height:100%">
          <defs>
            <!-- Sky: bright Pacific NW daytime blue -->
            <linearGradient id="sky" x1="0" y1="0" x2="0" y2="1">
              <stop offset="0%"   stop-color="#6aaed8"/>
              <stop offset="55%"  stop-color="#9ecce8"/>
              <stop offset="100%" stop-color="#bcddf2"/>
            </linearGradient>
            <!-- Warm afternoon sun flooding from upper-right -->
            <radialGradient id="sunray" cx="0.82" cy="0.0" r="0.75">
              <stop offset="0%"   stop-color="#fff8c8" stop-opacity="0.92"/>
              <stop offset="38%"  stop-color="#ffec70" stop-opacity="0.38"/>
              <stop offset="100%" stop-color="#ffec70" stop-opacity="0"/>
            </radialGradient>
            <!-- Dappled sunlight pools on ground -->
            <radialGradient id="dapple" cx="0.5" cy="0.5" r="0.5">
              <stop offset="0%"   stop-color="#f8e840" stop-opacity="0.58"/>
              <stop offset="100%" stop-color="#f8e840" stop-opacity="0"/>
            </radialGradient>
            <!-- Dome glass: nearly clear, faint teal -->
            <radialGradient id="dome-glass" cx="0.32" cy="0.22" r="0.80">
              <stop offset="0%"   stop-color="#ffffff"  stop-opacity="0.18"/>
              <stop offset="40%"  stop-color="#90d0d0"  stop-opacity="0.06"/>
              <stop offset="100%" stop-color="#2a8080"  stop-opacity="0.15"/>
            </radialGradient>
            <!-- Dome specular bright patch upper-left -->
            <radialGradient id="dome-spec" cx="0.24" cy="0.16" r="0.44">
              <stop offset="0%"   stop-color="#ffffff" stop-opacity="0.85"/>
              <stop offset="50%"  stop-color="#ffffff" stop-opacity="0.25"/>
              <stop offset="100%" stop-color="#ffffff" stop-opacity="0"/>
            </radialGradient>
            <!-- Forest reflection inside dome -->
            <radialGradient id="dome-refl" cx="0.50" cy="0.28" r="0.68">
              <stop offset="0%"   stop-color="#1e3018" stop-opacity="0.50"/>
              <stop offset="55%"  stop-color="#2e4228" stop-opacity="0.24"/>
              <stop offset="100%" stop-color="#1e3018" stop-opacity="0"/>
            </radialGradient>
            <!-- Clip dome contents -->
            <clipPath id="dome-clip">
              <ellipse cx="720" cy="472" rx="192" ry="222"/>
            </clipPath>
          </defs>

