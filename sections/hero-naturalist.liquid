            <path d="M11,-3 C32,-8 57,-4 70,5"  stroke="#d6d4cc" stroke-width="2.2" fill="none" opacity="0.46"/>
            <path d="M9,1   C28,-3 49,1  60,9"  stroke="#d6d4cc" stroke-width="1.6" fill="none" opacity="0.38"/>
            <!-- Body -->
            <ellipse cx="2" cy="8" rx="44" ry="27" fill="#f5f3ee"/>
            <!-- Breast sunlit highlight -->
            <ellipse cx="8" cy="9" rx="29" ry="18" fill="#ffffff" opacity="0.50"/>
            <!-- Feather texture -->
            <path d="M-36,7  C-15,2  8,4  24,10" stroke="#dbdad2" stroke-width="1.2" fill="none" opacity="0.35"/>
            <path d="M-32,17 C-11,12 11,14 26,20" stroke="#dbdad2" stroke-width="1.0" fill="none" opacity="0.28"/>
            <!-- Neck -->
            <path d="M24,-12 C32,-26 34,-40 26,-46 C18,-42 13,-27 16,-14 Z" fill="#eeecea"/>
            <!-- Head -->
            <circle cx="30" cy="-46" r="22" fill="#f4f2ec"/>
            <!-- Crown subtle -->
            <path d="M13,-63 C22,-72 40,-72 49,-63 C41,-54 30,-46 30,-46 C24,-52 17,-57 13,-63 Z" fill="#d4d2ca" opacity="0.32"/>
            <!-- Face highlight -->
            <ellipse cx="43" cy="-52" rx="12" ry="9" fill="#ffffff" opacity="0.44"/>
            <!-- Eye: Barbary dove orange-red orbital ring -->
            <circle cx="45" cy="-50" r="7.5"  fill="#d43e0e" opacity="0.94"/>
            <circle cx="45" cy="-50" r="5.2"  fill="#0a0402"/>
            <circle cx="44" cy="-51" r="2.4"  fill="#ffffff" opacity="0.96"/>
            <circle cx="47" cy="-49" r="1.1"  fill="#ffffff" opacity="0.44"/>
            <!-- Bill -->
            <path d="M54,-51 C66,-50 70,-47 68,-43 C64,-40 54,-42 52,-47 Z" fill="#c49060"/>
            <path d="M52,-47 C62,-45 66,-42 64,-38 C60,-36 52,-38 51,-41 Z" fill="#d4a070"/>
            <!-- Tail -->
            <path d="M-42,9 C-62,18 -66,31 -58,37 C-50,25 -38,16 -28,14 Z" fill="#eae8e0"/>
            <path d="M-38,11 C-54,22 -56,33 -48,37 C-42,27 -32,18 -24,15 Z" fill="#f2f0ea" opacity="0.55"/>
            <!-- Feet on rope -->
            <path d="M-2,30  L-2,43"  stroke="#dea050" stroke-width="4.5" fill="none" stroke-linecap="round"/>
            <path d="M15,30  L15,43"  stroke="#dea050" stroke-width="4.5" fill="none" stroke-linecap="round"/>
            <path d="M-2,43 C-9,48 -20,50 -25,47"  stroke="#dea050" stroke-width="3.2" fill="none" stroke-linecap="round"/>
            <path d="M-2,43 C5,48  14,50  18,46"   stroke="#dea050" stroke-width="3.2" fill="none" stroke-linecap="round"/>
            <path d="M-2,43 C-2,50 -2,57 -3,60"   stroke="#dea050" stroke-width="2.6" fill="none" stroke-linecap="round"/>
            <path d="M15,43 C22,48 32,50  36,46"   stroke="#dea050" stroke-width="3.2" fill="none" stroke-linecap="round"/>
            <path d="M15,43 C8,48  -1,50  -5,46"   stroke="#dea050" stroke-width="3.2" fill="none" stroke-linecap="round"/>
            <path d="M15,43 C15,50 15,57  14,60"   stroke="#dea050" stroke-width="2.6" fill="none" stroke-linecap="round"/>
          </g>

          <!-- ══════════════════════════════════════
               PEABODY — buff/cinnamon dove (lower, floor)
          ══════════════════════════════════════ -->
          <g transform="translate(742,600)">
            <!-- Body — plump, settled, slightly tilted -->
            <ellipse cx="0" cy="2" rx="58" ry="35" fill="#d0a268" transform="rotate(4,0,2)"/>
            <!-- Left wing over back (folded, darker) -->
            <path d="M-52,-10 C-74,-28 -68,-46 -30,-36
                     C-10,-27 6,-12 2,5 C-13,14 -36,12 -52,-10 Z"
                  fill="#b88858"/>
            <!-- Wing feather lines -->
            <path d="M-50,-10 C-33,-26  -6,-28  9,-15" stroke="#a07848" stroke-width="2.4" fill="none" opacity="0.54"/>
            <path d="M-44,-7  C-28,-21  -3,-23  11,-11" stroke="#a07848" stroke-width="2.0" fill="none" opacity="0.46"/>
            <path d="M-36,-4  C-22,-16  -1,-18  13,-8"  stroke="#a87c50" stroke-width="1.5" fill="none" opacity="0.36"/>
            <!-- Breast / belly highlight -->
            <ellipse cx="9" cy="7" rx="36" ry="25" fill="#e8c888" opacity="0.54"/>
            <!-- Rump feather texture -->
            <path d="M-46,5  C-27,0  -3,2  17,8"  stroke="#b09060" stroke-width="1.3" fill="none" opacity="0.30"/>
            <path d="M-44,16 C-25,11 -1,13 19,19" stroke="#b09060" stroke-width="1.1" fill="none" opacity="0.24"/>
            <!-- Neck -->
            <path d="M32,-12 C40,-26 42,-42 34,-48 C25,-44 20,-29 23,-14 Z" fill="#c09a64"/>
            <!-- Barbary dove black nape collar -->
            <path d="M28,-48 C22,-60  7,-64  -8,-62
                     C-21,-60 -26,-47 -21,-38
                     C-14,-44  -2,-46  9,-44
                     C18,-42  24,-40  26,-44 Z"
                  fill="#120c06" opacity="0.82"/>
            <!-- Head -->
            <circle cx="38" cy="-48" r="24" fill="#d0a268"/>
            <!-- Crown shading -->
            <path d="M20,-68 C30,-76 50,-76 60,-68 C52,-59 38,-48 38,-48 C32,-54 24,-61 20,-68 Z" fill="#a07848" opacity="0.34"/>
            <!-- Face highlight -->
            <ellipse cx="50" cy="-56" rx="14" ry="10" fill="#e8c280" opacity="0.50"/>
            <!-- Eye: Barbary dove orange-red orbital ring -->
            <circle cx="54" cy="-56" r="8.5"  fill="#d43e0e" opacity="0.94"/>
            <circle cx="54" cy="-56" r="5.8"  fill="#0a0402"/>
            <circle cx="53" cy="-57" r="2.6"  fill="#ffffff" opacity="0.96"/>
            <circle cx="57" cy="-55" r="1.2"  fill="#ffffff" opacity="0.38"/>
            <!-- Bill -->
            <path d="M63,-58 C76,-56 80,-53 78,-48 C74,-45 63,-47 61,-52 Z" fill="#a07858"/>
            <path d="M61,-52 C72,-49 76,-46 74,-42 C70,-39 61,-41 59,-45 Z" fill="#b08868"/>
            <!-- Tail -->
            <path d="M-56,7 C-77,18 -81,32 -72,38 C-62,24 -50,15 -38,14 Z" fill="#c09860"/>
            <path d="M-52,9 C-68,22 -70,34 -62,38 C-54,28 -44,19 -34,16 Z" fill="#d0a870" opacity="0.52"/>
            <!-- Feet sitting on substrate -->
            <path d="M-4,33 C-8,44 -10,54 -10,59"  stroke="#c09060" stroke-width="4.2" fill="none" stroke-linecap="round"/>
            <path d="M17,35 C19,46 19,56 18,61"    stroke="#c09060" stroke-width="4.2" fill="none" stroke-linecap="round"/>
            <path d="M-10,59 C-17,64 -28,66 -34,62" stroke="#c09060" stroke-width="3.2" fill="none" stroke-linecap="round"/>
            <path d="M-10,59 C-3,64   7,65   11,62" stroke="#c09060" stroke-width="3.2" fill="none" stroke-linecap="round"/>
            <path d="M-10,59 C-10,66 -10,72 -11,76" stroke="#c09060" stroke-width="2.6" fill="none" stroke-linecap="round"/>
            <path d="M18,61 C11,66   1,67  -3,63"   stroke="#c09060" stroke-width="3.2" fill="none" stroke-linecap="round"/>
            <path d="M18,61 C25,66  35,67  39,63"   stroke="#c09060" stroke-width="3.2" fill="none" stroke-linecap="round"/>
            <path d="M18,61 C18,68  18,74  17,78"   stroke="#c09060" stroke-width="2.6" fill="none" stroke-linecap="round"/>
          </g>
        </svg>
      </div>
    {%- endif -%}
    <div class="hero__overlay" style="opacity: {{ section.settings.overlay_opacity | divided_by: 100.0 }}"></div>
  </div>

  <div class="hero__inner container">

    {%- comment -%} Left / main copy column {%- endcomment -%}
    <div class="hero__content">
      {%- if section.settings.eyebrow != blank -%}
        <p class="hero__eyebrow">{{ section.settings.eyebrow }}</p>
      {%- endif -%}
      <h1 class="hero__title">{{ section.settings.title }}</h1>
      {%- if section.settings.subtitle != blank -%}
        <p class="hero__subtitle">{{ section.settings.subtitle }}</p>
      {%- endif -%}
      {%- if section.settings.button_label != blank -%}
        <a href="{{ section.settings.button_link | default: '/collections/all' }}"
           class="btn btn--primary hero__cta">
          {{ section.settings.button_label }}
        </a>
      {%- endif -%}
    </div>

    {%- comment -%} Right / bird panel column (optional) {%- endcomment -%}
    {%- if section.settings.show_bird_panel -%}
      <div class="hero__bird-panel">
        {%- if section.settings.bird_image != blank -%}
          <div class="hero__bird-image">
            <img src="{{ section.settings.bird_image | image_url: width: 560 }}"
                 srcset="{{ section.settings.bird_image | image_url: width: 280 }} 280w,
                         {{ section.settings.bird_image | image_url: width: 560 }} 560w"
                 sizes="(max-width: 900px) 60vw, 320px"
                 alt="{{ section.settings.bird_image.alt | default: 'Bird illustration' | escape }}"
                 loading="eager">
          </div>
        {%- endif -%}
        {%- if section.settings.bird_panel_heading != blank or section.settings.bird_panel_body != blank -%}
          <div class="hero__bird-copy">
            {%- if section.settings.bird_panel_heading != blank -%}
              <p class="hero__bird-heading">{{ section.settings.bird_panel_heading }}</p>
            {%- endif -%}
            {%- if section.settings.bird_panel_body != blank -%}
              <p class="hero__bird-body">{{ section.settings.bird_panel_body }}</p>
            {%- endif -%}
          </div>
        {%- endif -%}
      </div>
    {%- endif -%}

  </div>
</section>

{% schema %}
{
  "name": "Hero - Naturalist",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Background image"
    },
    {
      "type": "range",
      "id": "height",
      "min": 40,
      "max": 100,
      "step": 5,
      "unit": "vh",
      "label": "Hero height",
      "default": 85
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "min": 0,
      "max": 80,
      "step": 5,
      "label": "Overlay opacity %",
      "default": 30
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow text",
      "default": "Atlas Dovy"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "Dressed for the Field"
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "Subheading",
      "default": "Wear the birds. Pieces drawn from Pacific Northwest field journals."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Shop Now"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },
    {
      "type": "header",
      "content": "Bird Panel"
    },
    {
      "type": "checkbox",
      "id": "show_bird_panel",
      "label": "Show bird panel",
      "default": true,
      "info": "Adds a second column with a bird illustration and short copy."
    },
    {
      "type": "image_picker",
      "id": "bird_image",
      "label": "Bird illustration image",
      "info": "Works best with a transparent-background PNG or a portrait crop. Recommended width: 560px."
    },
    {
      "type": "text",
      "id": "bird_panel_heading",
      "label": "Bird panel heading",
      "default": "Spotted in the Wild"
    },
    {
      "type": "textarea",
      "id": "bird_panel_body",
      "label": "Bird panel body text",
      "default": "Every Atlas Dovy design starts with a sketch in the field. From Steller's Jays to Great Horned Owls, our prints are drawn from Mel's firsthand observations across the Pacific Northwest."
    }
  ],
  "presets": [
    {
      "name": "Hero - Naturalist"
    }
  ]
}
{% endschema %}
