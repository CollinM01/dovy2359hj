<section class="hero-naturalist{% if section.settings.show_bird_panel %} hero-naturalist--split{% endif %}"
         style="--hero-height: {{ section.settings.height }}vh">
  <div class="hero__media">
    {%- if section.settings.image != blank -%}
      <img class="hero__image"
           src="{{ section.settings.image | image_url: width: 2000 }}"
           srcset="{{ section.settings.image | image_url: width: 750 }} 750w,
                   {{ section.settings.image | image_url: width: 1100 }} 1100w,
                   {{ section.settings.image | image_url: width: 1500 }} 1500w,
                   {{ section.settings.image | image_url: width: 2000 }} 2000w"
           sizes="100vw"
           width="{{ section.settings.image.width }}"
           height="{{ section.settings.image.height }}"
           alt="{{ section.settings.image.alt | escape }}"
           loading="eager"
           fetchpriority="high">
    {%- else -%}
      <div class="hero__placeholder hero__placeholder--birds" aria-hidden="true">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1440 810" preserveAspectRatio="xMidYMid slice">
          <defs>
            <!-- Original PNW field sky: deep navy-forest → dark green -->
            <linearGradient id="sky-grad" x1="0" y1="0" x2="0" y2="1">
              <stop offset="0%"   stop-color="#1a2e3b"/>
              <stop offset="55%"  stop-color="#2d4a38"/>
              <stop offset="100%" stop-color="#1c2c1e"/>
            </linearGradient>
            <!-- Mist layer over treeline -->
            <linearGradient id="mist-grad" x1="0" y1="0" x2="0" y2="1">
              <stop offset="0%"   stop-color="#4a6b52" stop-opacity="0.6"/>
              <stop offset="100%" stop-color="#4a6b52" stop-opacity="0"/>
            </linearGradient>
            <!-- Subtle warm horizon glow through the PNW field scene -->
            <radialGradient id="horizon-glow" cx="0.5" cy="0.72" r="0.45" gradientUnits="objectBoundingBox">
              <stop offset="0%"   stop-color="#c8a882" stop-opacity="0.22"/>
              <stop offset="60%"  stop-color="#b89068" stop-opacity="0.10"/>
              <stop offset="100%" stop-color="#a07840" stop-opacity="0"/>
            </radialGradient>
          </defs>

          <!-- ═══ SKY ═══ -->
          <rect width="1440" height="810" fill="url(#sky-grad)"/>
          <!-- Warm horizon glow through the middle of the scene -->
          <rect width="1440" height="810" fill="url(#horizon-glow)"/>

          <!-- Distant moon / hazy orb — upper right -->
          <circle cx="1060" cy="140" r="70" fill="#e8dfc8" opacity="0.18"/>
          <circle cx="1060" cy="140" r="52" fill="#f5f0e8" opacity="0.22"/>

          <!-- ═══ TREELINE LAYERS ═══ -->
          <!-- Layer 3: far distant (lightest, most receded) -->
          <path d="M0,680 Q80,620 140,660 Q200,640 260,620 Q320,600 380,630
                   Q440,610 500,595 Q560,580 620,605 Q680,590 740,575
                   Q800,560 860,585 Q920,570 980,555 Q1040,540 1100,565
                   Q1160,550 1220,535 Q1280,520 1340,545 Q1380,555 1440,540
                   L1440,810 L0,810 Z"
                fill="#2a4030" opacity="0.7"/>
          <!-- Layer 2: mid treeline -->
          <path d="M0,720 Q60,680 100,700
                   Q140,660 180,690 Q220,665 270,685
                   Q310,650 360,672 Q400,648 450,668
                   Q490,644 540,664 Q580,640 630,658
                   Q670,635 720,656 Q760,632 810,650
                   Q850,628 900,646 Q950,624 1000,642
                   Q1050,620 1100,640 Q1150,618 1200,636
                   Q1250,615 1300,632 Q1360,610 1440,625
                   L1440,810 L0,810 Z"
                fill="#1e3026" opacity="0.85"/>

          <!-- ═══ FOREGROUND TREE SILHOUETTES ═══ -->
          <!-- Tall firs — left cluster -->
          <polygon points="60,560  80,440  100,560"  fill="#12201a"/>
          <polygon points="90,590  115,450 140,590"  fill="#0e1c15"/>
          <polygon points="120,610 148,460 176,610"  fill="#12201a"/>
          <polygon points="30,620  52,500  74,620"   fill="#0e1c15"/>
          <!-- Tall firs — right cluster -->
          <polygon points="1300,580 1320,445 1340,580" fill="#12201a"/>
          <polygon points="1330,600 1355,460 1380,600" fill="#0e1c15"/>
          <polygon points="1360,615 1388,475 1416,615" fill="#12201a"/>
          <polygon points="1265,595 1285,460 1305,595" fill="#0e1c15"/>
          <!-- Mid scattered firs -->
          <polygon points="420,640 438,520 456,640" fill="#162418"/>
          <polygon points="640,635 660,510 680,635" fill="#12201a"/>
          <polygon points="840,640 862,515 884,640" fill="#162418"/>
          <polygon points="1060,630 1082,505 1104,630" fill="#12201a"/>

          <!-- ═══ MIST ═══ -->
          <rect x="0" y="580" width="1440" height="120" fill="url(#mist-grad)"/>

          <!-- ═══ SOARING WILD BIRDS (original field design) ═══ -->
          <!-- Bird 1 — large hawk, mid-left, full soaring wing shape -->
          <g transform="translate(280, 195)" opacity="0.92">
            <path d="M0,0 C-18,-8 -42,-5 -58,4 C-42,2 -22,8 0,0 Z" fill="#e8dfc8"/>
            <path d="M0,0 C18,-8 42,-5 58,4 C42,2 22,8 0,0 Z" fill="#e8dfc8"/>
            <path d="M0,0 C-4,6 -2,12 0,14 C2,12 4,6 0,0 Z" fill="#d4cfc4"/>
          </g>
          <!-- Bird 2 — upper-center, slightly smaller -->
          <g transform="translate(620, 145)" opacity="0.85">
            <path d="M0,0 C-14,-6 -32,-4 -44,3 C-32,1 -16,6 0,0 Z" fill="#e8dfc8"/>
            <path d="M0,0 C14,-6 32,-4 44,3 C32,1 16,6 0,0 Z" fill="#e8dfc8"/>
            <path d="M0,0 C-3,5 -1,10 0,11 C1,10 3,5 0,0 Z" fill="#d4cfc4"/>
          </g>
          <!-- Bird 3 — upper-right, small, distant -->
          <g transform="translate(980, 120)" opacity="0.7">
            <path d="M0,0 C-9,-4 -22,-3 -30,2 C-22,1 -10,4 0,0 Z" fill="#c8c4bc"/>
            <path d="M0,0 C9,-4 22,-3 30,2 C22,1 10,4 0,0 Z" fill="#c8c4bc"/>
          </g>
          <!-- Bird 4 — very distant, tiny -->
          <g transform="translate(820, 100)" opacity="0.55">
            <path d="M0,0 C-6,-3 -15,-2 -20,1 C-15,0 -7,3 0,0 Z" fill="#b0aba3"/>
            <path d="M0,0 C6,-3 15,-2 20,1 C15,0 7,3 0,0 Z" fill="#b0aba3"/>
          </g>
          <!-- Bird 5 — mid-right, medium -->
          <g transform="translate(1150, 230)" opacity="0.88">
            <path d="M0,0 C-16,-7 -36,-4 -50,3 C-36,2 -18,7 0,0 Z" fill="#e8dfc8"/>
            <path d="M0,0 C16,-7 36,-4 50,3 C36,2 18,7 0,0 Z" fill="#e8dfc8"/>
            <path d="M0,0 C-3,5 -1,9 0,11 C1,9 3,5 0,0 Z" fill="#d4cfc4"/>
          </g>
          <!-- Bird 6 — lower-left, large (heron spread) -->
          <g transform="translate(185, 310)" opacity="0.8">
            <path d="M0,0 C-22,-10 -50,-6 -68,5 C-50,3 -26,10 0,0 Z" fill="#ddd8ce"/>
            <path d="M0,0 C22,-10 50,-6 68,5 C50,3 26,10 0,0 Z" fill="#ddd8ce"/>
            <path d="M0,0 C-4,8 -2,16 0,18 C2,16 4,8 0,0 Z" fill="#c8c4bc"/>
          </g>
          <!-- Bird flock — 5 tiny birds upper-centre-right -->
          <g opacity="0.6" fill="#b8b3ab">
            <path transform="translate(700,88)"  d="M0,0 C-5,-2 -12,-2 -16,1 C-12,0 -6,2 0,0 Z M0,0 C5,-2 12,-2 16,1 C12,0 6,2 0,0 Z"/>
            <path transform="translate(718,82)"  d="M0,0 C-4,-2 -10,-1 -14,1 C-10,0 -5,2 0,0 Z M0,0 C4,-2 10,-1 14,1 C10,0 5,2 0,0 Z"/>
            <path transform="translate(735,90)"  d="M0,0 C-4,-2 -10,-1 -14,1 C-10,0 -5,2 0,0 Z M0,0 C4,-2 10,-1 14,1 C10,0 5,2 0,0 Z"/>
            <path transform="translate(748,84)"  d="M0,0 C-3,-1 -8,-1 -11,1 C-8,0 -4,1 0,0 Z M0,0 C3,-1 8,-1 11,1 C8,0 4,1 0,0 Z"/>
            <path transform="translate(760,92)"  d="M0,0 C-3,-1 -8,-1 -11,1 C-8,0 -4,1 0,0 Z M0,0 C3,-1 8,-1 11,1 C8,0 4,1 0,0 Z"/>
          </g>

          <!-- ═══ GREAT BLUE HERON — silhouette in flight above treeline ═══
               The most recognisable PNW large bird in flight: neck folded
               in S-curve, very long wings, trailing legs extended behind.
               Rendered as a pure dark silhouette — no fill details, no character.
               Flying left-to-right, low in the scene just above the mist. -->
          <g transform="translate(690, 490)" opacity="0.82">
            <!-- Right wing — outstretched, bowed slightly at wrist -->
            <path d="M0,0 C18,-12 50,-18 88,-8 C110,-2 126,6 118,14
                     C100,8 72,4 46,10 C24,14 8,10 0,0 Z"
                  fill="#162018"/>
            <!-- Left wing — matching, slightly higher at tip -->
            <path d="M0,0 C-16,-14 -46,-22 -82,-14 C-104,-8 -118,2 -110,10
                     C-94,4 -68,0 -42,6 C-20,10 -6,8 0,0 Z"
                  fill="#162018"/>
            <!-- Body — elongated, low-slung between wings -->
            <path d="M-14,2 C-8,-4 8,-4 14,2 C10,8 0,12 -4,12 C-10,10 -14,8 -14,2 Z"
                  fill="#0e1810"/>
            <!-- Neck S-curve — head pulled back onto shoulders (heron's flight posture) -->
            <!-- Lower neck (horizontal, tucked toward body) -->
            <path d="M10,-2 C18,0 24,-4 26,-12"
                  stroke="#0e1810" stroke-width="5" fill="none" stroke-linecap="round"/>
            <!-- Upper neck (angled forward and down — the S) -->
            <path d="M26,-12 C28,-22 24,-30 18,-34"
                  stroke="#0e1810" stroke-width="4" fill="none" stroke-linecap="round"/>
            <!-- Head — flat, angular (heron has flat crown) -->
            <path d="M18,-34 C14,-40 10,-42 6,-40 C8,-36 14,-32 18,-34 Z"
                  fill="#0e1810"/>
            <!-- Dagger bill — long, pointed straight forward -->
            <path d="M6,-40 C-4,-42 -14,-42 -22,-40 C-14,-38 -4,-36 6,-40 Z"
                  fill="#0e1810"/>
            <!-- Trailing legs — heron extends legs straight behind in flight -->
            <path d="M-8,10 C-10,22 -12,34 -12,44"
                  stroke="#0e1810" stroke-width="3" fill="none" stroke-linecap="round"/>
            <path d="M-4,12 C-4,24 -4,36 -2,46"
                  stroke="#0e1810" stroke-width="3" fill="none" stroke-linecap="round"/>
            <!-- Feet dangling slightly (not folded tight — typical in slow glide) -->
            <path d="M-12,44 C-16,48 -20,50 -22,50" stroke="#0e1810" stroke-width="2.5" fill="none" stroke-linecap="round"/>
            <path d="M-12,44 C-10,48 -8,52 -8,54"   stroke="#0e1810" stroke-width="2.5" fill="none" stroke-linecap="round"/>
            <path d="M-2,46  C-6,50 -10,52 -12,52"  stroke="#0e1810" stroke-width="2.5" fill="none" stroke-linecap="round"/>
            <path d="M-2,46  C2,50 6,54 8,56"        stroke="#0e1810" stroke-width="2.5" fill="none" stroke-linecap="round"/>
          </g>
          <!-- /heron -->

          <!-- ═══ OSPREY — banking hard right, lower-left sky ═══
               Distinctive bent-wing shape (crooked at wrist, almost M-shaped),
               white belly flashing in the light. Pure silhouette + pale underside. -->
          <g transform="translate(380, 290)" opacity="0.78">
            <!-- Left wing — angled up, bent at wrist (osprey's kinked wing) -->
            <path d="M0,0 C-12,-8 -28,-6 -38,0 C-46,4 -52,10 -48,16
                     C-40,10 -28,6 -16,8 C-8,10 -2,6 0,0 Z"
                  fill="#182420"/>
            <!-- Right wing — angled down, also kinked -->
            <path d="M0,0 C10,-10 26,-10 36,-4 C44,2 48,8 44,14
                     C36,8 24,4 12,6 C4,8 0,4 0,0 Z"
                  fill="#182420"/>
            <!-- Body — compact, torpedo-shaped -->
            <path d="M-8,4 C-4,-2 4,-2 8,4 C6,10 0,13 -3,13 C-7,11 -8,8 -8,4 Z"
                  fill="#0e1810"/>
            <!-- Pale belly flash (white underpart catching sky light) -->
            <path d="M-5,5 C-2,2 3,2 6,5 C4,9 0,11 -2,11 C-5,9 -5,7 -5,5 Z"
                  fill="#2a3c30" opacity="0.5"/>
            <!-- Head — round, looking forward -->
            <ellipse cx="10" cy="-4" rx="6" ry="5" fill="#0e1810"/>
          </g>
          <!-- /osprey -->

        </svg>
      </div>
    {%- endif -%}
    <div class="hero__overlay" style="opacity: {{ section.settings.overlay_opacity | divided_by: 100.0 }}"></div>
  </div>

  <div class="hero__inner container">

    {%- comment -%} Left / main copy column {%- endcomment -%}
    <div class="hero__content">
      {%- if section.settings.eyebrow != blank -%}
        <p class="hero__eyebrow">{{ section.settings.eyebrow }}</p>
      {%- endif -%}
      <h1 class="hero__title">{{ section.settings.title }}</h1>
      {%- if section.settings.subtitle != blank -%}
        <p class="hero__subtitle">{{ section.settings.subtitle }}</p>
      {%- endif -%}
      {%- if section.settings.button_label != blank -%}
        <a href="{{ section.settings.button_link | default: '/collections/all' }}"
           class="btn btn--primary hero__cta">
          {{ section.settings.button_label }}
        </a>
      {%- endif -%}
    </div>

    {%- comment -%} Right / bird panel column (optional) {%- endcomment -%}
    {%- if section.settings.show_bird_panel -%}
      <div class="hero__bird-panel">
        {%- if section.settings.bird_image != blank -%}
          <div class="hero__bird-image">
            <img src="{{ section.settings.bird_image | image_url: width: 560 }}"
                 srcset="{{ section.settings.bird_image | image_url: width: 280 }} 280w,
                         {{ section.settings.bird_image | image_url: width: 560 }} 560w"
                 sizes="(max-width: 900px) 60vw, 320px"
                 alt="{{ section.settings.bird_image.alt | default: 'Bird illustration' | escape }}"
                 loading="eager">
          </div>
        {%- endif -%}
        {%- if section.settings.bird_panel_heading != blank or section.settings.bird_panel_body != blank -%}
          <div class="hero__bird-copy">
            {%- if section.settings.bird_panel_heading != blank -%}
              <p class="hero__bird-heading">{{ section.settings.bird_panel_heading }}</p>
            {%- endif -%}
            {%- if section.settings.bird_panel_body != blank -%}
              <p class="hero__bird-body">{{ section.settings.bird_panel_body }}</p>
            {%- endif -%}
          </div>
        {%- endif -%}
      </div>
    {%- endif -%}

  </div>
</section>

{% schema %}
{
  "name": "Hero - Naturalist",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Background image"
    },
    {
      "type": "range",
      "id": "height",
      "min": 40,
      "max": 100,
      "step": 5,
      "unit": "vh",
      "label": "Hero height",
      "default": 85
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "min": 0,
      "max": 80,
      "step": 5,
      "label": "Overlay opacity %",
      "default": 30
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow text",
      "default": "Atlas Dovy"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "Dressed for the Field"
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "Subheading",
      "default": "Wear the birds. Pieces drawn from Pacific Northwest field journals."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Shop Now"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },
    {
      "type": "header",
      "content": "Bird Panel"
    },
    {
      "type": "checkbox",
      "id": "show_bird_panel",
      "label": "Show bird panel",
      "default": true,
      "info": "Adds a second column with a bird illustration and short copy."
    },
    {
      "type": "image_picker",
      "id": "bird_image",
      "label": "Bird illustration image",
      "info": "Works best with a transparent-background PNG or a portrait crop. Recommended width: 560px."
    },
    {
      "type": "text",
      "id": "bird_panel_heading",
      "label": "Bird panel heading",
      "default": "Spotted in the Wild"
    },
    {
      "type": "textarea",
      "id": "bird_panel_body",
      "label": "Bird panel body text",
      "default": "Every Atlas Dovy design starts with a sketch in the field. From Steller's Jays to Great Horned Owls, our prints are drawn from Mel's firsthand observations across the Pacific Northwest."
    }
  ],
  "presets": [
    {
      "name": "Hero - Naturalist"
    }
  ]
}
{% endschema %}
