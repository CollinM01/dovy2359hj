          ══════════════════════════════════════ -->
          <!-- Vertical anchor lines inside dome -->
          <line x1="560" y1="460" x2="560" y2="542" stroke="#2c8a86" stroke-width="5.5" stroke-linecap="round" opacity="0.70"/>
          <line x1="880" y1="460" x2="880" y2="542" stroke="#2c8a86" stroke-width="5.5" stroke-linecap="round" opacity="0.70"/>
          <!-- Hammock strands — catenary curve, 3 colored ropes -->
          <path d="M560,542 Q642,520 720,516 Q798,520 880,542"
                stroke="#cc2c24" stroke-width="8" fill="none" stroke-linecap="round"/>
          <path d="M560,547 Q642,525 720,521 Q798,525 880,547"
                stroke="#2858cc" stroke-width="6" fill="none" stroke-linecap="round"/>
          <path d="M560,551 Q642,529 720,525 Q798,529 880,551"
                stroke="#28a82c" stroke-width="4.5" fill="none" stroke-linecap="round"/>
          <path d="M560,554 Q642,532 720,528 Q798,532 880,554"
                stroke="#cc2c24" stroke-width="3" fill="none" stroke-linecap="round" opacity="0.52"/>

          <!-- ══════════════════════════════════════
               WOOD CHIP SUBSTRATE FLOOR
          ══════════════════════════════════════ -->
          <ellipse cx="720" cy="668" rx="175" ry="36" fill="#8a6032" opacity="0.55"/>
          <ellipse cx="720" cy="674" rx="168" ry="28" fill="#7a5028" opacity="0.40"/>
          <!-- Chip texture -->
          <path d="M578,664 Q604,658 632,662"  stroke="#6a4820" stroke-width="2.5" fill="none" opacity="0.44" stroke-linecap="round"/>
          <path d="M650,677 Q678,670 706,674"  stroke="#6a4820" stroke-width="2.2" fill="none" opacity="0.38" stroke-linecap="round"/>
          <path d="M736,674 Q764,667 793,671"  stroke="#6a4820" stroke-width="2.5" fill="none" opacity="0.42" stroke-linecap="round"/>
          <path d="M812,664 Q837,658 862,662"  stroke="#6a4820" stroke-width="2"   fill="none" opacity="0.36" stroke-linecap="round"/>
          <path d="M608,688 Q635,682 660,686"  stroke="#6a4820" stroke-width="2"   fill="none" opacity="0.30" stroke-linecap="round"/>
          <path d="M767,688 Q792,682 818,686"  stroke="#6a4820" stroke-width="2"   fill="none" opacity="0.30" stroke-linecap="round"/>
          <path d="M682,698 Q708,692 734,696"  stroke="#6a4820" stroke-width="1.8" fill="none" opacity="0.26" stroke-linecap="round"/>

          <!-- ══════════════════════════════════════
               ATLAS — pure white dove (upper, on hammock)
          ══════════════════════════════════════ -->
          <g transform="translate(728,456)">
            <!-- Left wing (relaxed, spread slightly over hammock) -->
            <path d="M-11,-3 C-35,-14 -62,-8 -76,5 C-61,9 -38,13 -16,7 Z" fill="#edebe4"/>
            <path d="M-11,-3 C-32,-8 -57,-4 -70,5"  stroke="#d6d4cc" stroke-width="2.2" fill="none" opacity="0.46"/>
            <path d="M-9,1   C-28,-3 -49,1  -60,9"  stroke="#d6d4cc" stroke-width="1.6" fill="none" opacity="0.38"/>
