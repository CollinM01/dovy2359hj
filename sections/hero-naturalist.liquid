          <!-- Bead 3 -->
          <circle cx="612" cy="456" r="15" fill="#c8a058" stroke="#8a6828" stroke-width="2.5"/>
          <circle cx="612" cy="456" r="8"  fill="#ddb86a"/>

          <!-- ══════════════════════════════════════
