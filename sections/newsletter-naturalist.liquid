<section class="section container newsletter-box">
  <h2>{{ section.settings.heading }}</h2>
  <p>{{ section.settings.body }}</p>
  {% form 'customer', class: 'newsletter-form' %}
    <input type="hidden" name="contact[tags]" value="newsletter">
    <input type="email" name="contact[email]" required placeholder="Email address">
    <button class="button" type="submit">{{ section.settings.button_label }}</button>
  {% endform %}
</section>

{% schema %}
{
  "name": "Newsletter naturalist",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Get weekly field notes" },
    { "type": "textarea", "id": "body", "label": "Body", "default": "New drops, birding insights, and conservation updates from the Atlas Dovy trail." },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Subscribe" }
  ],
  "presets": [{ "name": "Newsletter naturalist" }]
}
{% endschema %}
