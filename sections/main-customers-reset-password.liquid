<section class="section-padding">
  <div class="container container--xs">
    <h1 class="section-title">Reset Password</h1>
    <p style="margin-bottom:var(--space-6); color:var(--color-sage)">Enter a new password for your account.</p>

    {%- form 'reset_customer_password' -%}
      {%- if form.errors -%}
        <p style="color:#b94040; margin-bottom:var(--space-4)">{{ form.errors | default_errors }}</p>
      {%- endif -%}
      <div class="form-group">
        <label for="NewPassword">New Password</label>
        <input type="password" name="customer[password]" id="NewPassword" required>
      </div>
      <div class="form-group">
        <label for="NewPasswordConfirm">Confirm New Password</label>
        <input type="password" name="customer[password_confirmation]" id="NewPasswordConfirm" required>
      </div>
      <button type="submit" class="btn btn--primary btn--full">Reset Password</button>
    {%- endform -%}
  </div>
</section>

{% schema %}
{
  "name": "Reset Password",
  "settings": []
}
{% endschema %}
